          "value": true
        },
        {
          "type": "read-boolean",
          "key": "companyRecognitionPending",
          "operator": "equals",
          "value": true
        }
      ],
      "script": "const deeds = storage.companyDeeds || 0\nconst stage = storage.companyStage || 'new_house'\nconst headquarters = storage.companyHeadquartersImproved === true\nstorage.companyRecognitionPending = false\n\nif (stage === 'new_house' && deeds >= 1) {\n  storage.companyStage = 'known'\n  effects.push({ type: 'player-traits', operator: 'remove', value: 'Adventuring House Founder' })\n  effects.push({ type: 'player-traits', operator: 'add', value: 'Locally Known Adventuring House' })\n  effects.push({ type: 'quest-progress', questId: 'Make the Name Mean Something' })\n  effects.push({ type: 'quest-init', operator: 'set', value: 'Build the Adventuring House' })\n  effects.push({ type: 'story', instruction: 'Create a warm, interactive homecoming after the company’s first completed job. Payment, gratitude, witnesses, returned people, recovered proof, or local talk makes the deed tangible. People begin using the company name already established in the story; never invent a replacement. Establish the company as a name locals now know and make the request wall and central company table permanent. Offer a choice of a first substantial headquarters improvement—map room, bunks, armory, workshop, infirmary, stables or transport space, private meeting room, trophy display, or another practical facility—but do not choose for the player.' })\n} else if ((stage === 'known' || stage === 'new_house') && deeds >= 3 && headquarters) {\n  storage.companyStage = deeds >= 6 ? 'renowned' : 'established'\n  effects.push({ type: 'quest-progress', questId: 'Build the Adventuring House' })\n  effects.push({ type: 'quest-init', operator: 'set', value: 'Establish the Company' })\n  if (deeds >= 6) {\n    effects.push({ type: 'quest-progress', questId: 'Establish the Company' })\n    effects.push({ type: 'quest-init', operator: 'set', value: 'Build a Renowned Company' })\n    effects.push({ type: 'player-traits', operator: 'remove', value: 'Locally Known Adventuring House' })\n    effects.push({ type: 'player-traits', operator: 'add', value: 'Renowned Adventuring House' })\n    effects.push({ type: 'story', instruction: 'Create a major catch-up homecoming: the company’s completed deeds and established facility now make it regionally renowned. Clients and recruits travel specifically to this tavern. Offer a defining regional-scale commission and one meaningful further headquarters or transport improvement. The player still personally leads important work; delegation remains optional.' })\n  } else {\n    effects.push({ type: 'player-traits', operator: 'remove', value: 'Locally Known Adventuring House' })\n    effects.push({ type: 'player-traits', operator: 'add', value: 'Established Adventuring House' })\n    effects.push({ type: 'story', instruction: 'Create an earned established-company homecoming. Several clients know where to find the house, adventurers discuss joining, and one serious outside power offers an optional relationship: League affiliation, civic charter, guild or temple sponsorship, merchant-house backing, noble warrant, or continued independence with a valuable contact. Also surface one competent specialist applicant suited to the company’s demonstrated work. Do not assign a patron, charter, specialist, or recruit automatically.' })\n  }\n} else if (stage === 'known' && deeds >= 3 && !headquarters) {\n  effects.push({ type: 'story', instruction: 'Create a concise homecoming that acknowledges the company has completed enough deeds to become established but has not yet chosen a substantial headquarters facility. Make that remaining choice clear and offer several practical improvements suited to the actual tavern without choosing one for the player. Do not advance the company to established standing yet.' })\n} else if (stage === 'established' && deeds >= 6) {\n  storage.companyStage = 'renowned'\n  effects.push({ type: 'quest-progress', questId: 'Establish the Company' })\n  effects.push({ type: 'quest-init', operator: 'set', value: 'Build a Renowned Company' })\n  effects.push({ type: 'player-traits', operator: 'remove', value: 'Established Adventuring House' })\n  effects.push({ type: 'player-traits', operator: 'add', value: 'Renowned Adventuring House' })\n  effects.push({ type: 'story', instruction: 'Create a major return establishing the adventuring house as regionally renowned. Clients and recruits now travel specifically to this tavern, and its facilities, companions, patrons or independence, rivals, trophies, and relationships are visible. Offer a defining regional-scale commission and a meaningful headquarters or transport improvement. The player still personally leads important field work; delegation remains optional.' })\n} else {\n  effects.push({ type: 'story', instruction: 'Create a concise company homecoming grounded in the completed job: payment or gratitude, the keeper’s report, crew and regular reactions, one consequence for reputation or relationships, and any lead naturally produced by the deed. Do not repeat a founding or promotion scene.' })\n}",
      "effects": []
    },
