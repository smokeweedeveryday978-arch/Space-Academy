          ]
        },
        "The Inner Shrine": {
          "description": "The temple's main hall, a high pillared chamber roofed in ice, the old hearth-altars cold and choked with frost down its length. Where fires once burned there is only black stone and rime. The hall runs back toward the spring at the temple's heart, and side-chapels open off it into dark.",
          "paths": [
            "The Frozen Steps",
            "The Dead Spring"
          ]
        },
        "The Dead Spring": {
          "description": "The sacred spring at the temple's heart, the reason the shrine was raised — a wide pool in a domed sanctum, now a plug of black ice, the stonework around it white with frost. The cold is hardest here, harder than the open ice outside. The deepest sanctum lies beyond, behind the spring.",
          "paths": [
            "The Inner Shrine"
          ]
        }
