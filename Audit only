    "Saravadi Village": {
      "name": "Saravadi Village",
      "x": -12,
      "y": -2,
      "radius": 1,
      "region": "Ntar Vanna",
      "detailType": "detailed",
      "known": true,
      "complexityType": "complex",
      "basicInfo": "A farming village on the lower slopes of the Whitemount, ringed by rice terraces and jungle orchards. Saravadi takes three rice harvests a year and ships rice, fruit, and spice down to New Anthara. The village gathers under a great spreading tree at its heart, and its hedge-witches are known up and down the river for their jungle remedies and charms.",
      "hiddenInfo": "Saravadi is a warm, settled farming village and a good place to put down roots. The families here have worked these terraces for generations and take in newcomers who are willing to work. Demonborn and half-orc families hold most of the land and work it by hand; catkin caravan-families have settled in among them, and frogkin keep the irrigation channels running. Governance is by open meeting under the great tree, where the whole village has a voice.\n\nThe jungle is the village's one constant adversary. Left untended for a season, a terrace or grove is swallowed back into green, so there is always more clearing and holding work than there are hands. This is the standing work a newcomer can pick up: holding the edge, guarding the harvest.\n\nSaravadi's hedge-witches are the village's pride and its draw. They read the jungle and brew from it, making fever-cures, snakebite and leech draughts, wardings against the wild, and charms for a safe harvest, with a little coaxing of weather and growth. A newcomer with the gift can be taught the craft by helping and tending, the way it has always been passed down.\n\nThe terraces, the drying-barns, and the orchard groves lie around the village and can be visited or worked when a story calls for them.",
      "areas": {
        "The Greattree": {
          "description": "The village heart: a huge spreading tree over a packed-earth common, the terraced green hillside rising behind it. Benches, cookfires, and a low speaking-stone sit beneath the branches, where the village holds its open meetings. Paths run off between the houses toward the market and the riverbank.",
          "paths": [
            "The Market",
            "The Sleeping Croc"
          ]
        },
        "The Market": {
          "description": "A small open market of woven awnings and plank stalls. Farm tools, seed, and woven goods are sold alongside a hedge-witch's stall of dried jungle herbs, brewed remedies, and charms — fever-bark, snakebite cure, leech-draughts, and harvest-wards. Cookfires at the edge sell rice and river fish.",
          "paths": [
            "The Greattree",
            "The Sleeping Croc"
          ]
        },
        "The Sleeping Croc": {
          "description": "The village common-house, a long timber hall on stilts over the riverbank, named for the old crocodile that suns itself on the mud below and that the village has long since decided to leave be. Rice wine, the local catch, and a long shared table within; a deck out over the water where the croc can be watched at a safe distance.",
          "paths": [
            "The Greattree",
            "The Market"
          ]
        }
