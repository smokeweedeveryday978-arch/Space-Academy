        "The Mire-Paths": {
          "description": "The deep-fen tracks west, where the marsh closes over and the footing is hidden: causeways sunk just under the water, reed-tunnels, and channels that branch and double back.",
          "paths": [
            "The Sunken Holts"
          ]
        }
