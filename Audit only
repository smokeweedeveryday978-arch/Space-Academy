        "The Snowveil": {
          "description": "Broken country flanking the migration track — low ridges, drifted hollows, stands of wind-stunted scrub, and folds of ground that break the sightline. Snow lies deep and soft in the hollows. The high ground overlooks the herd-track below, and the cover runs unbroken along the edge of it.",
          "paths": [
            "The Migration"
          ]
        }
