        },
        "Morcroft Hall": {
          "description": "The great hall where the family holds court and dines with their warriors. Long tables, weapon-racks on the walls, old campaign banners from the war-kings' era. The lord or lady receives petitioners and guests here and offers work to those who impress.",
          "paths": [
            "The Training Yard"
          ]
        }
