      ],
      "script": "if (storage.tavernReopeningInitDone === true) { skip = true }\n\nconst pool = [[\"Ardan's Watch\", \"The Fist & Flagon\"], [\"Beggarsbridge\", \"The Waterline Inn\"], [\"Canopy\", \"The Silver Bough\"], [\"Coriva\", \"The Harpoon House\"], [\"Dun Solas\", \"The Wetted Whistle\"], [\"Freehaven\", \"The Above Board\"], [\"Gavarra\", \"Brightlights\"], [\"Gorren Crossing\", \"The Hearthstone\"], [\"Greenmeadow\", \"The Golden Grain\"], [\"Maanvalta\", \"The Hang-Over Inn\"], [\"Fallsmeet\", \"The White Wheel\"], [\"Tevantia\", \"The Two Swords\"], [\"The Crossroads Inn\", \"Taproom\"]]\nconst location = check({ type: 'party-location' }) || ''\nconst area = check({ type: 'party-area' }) || ''\nconst seated = pool.some(p => p[0] === location && p[1] === area)\nif (!seated) { skip = true }\n\nif (!skip) {\n  storage.tavernReopeningInitDone = true\n  storage.tavern_owner = true\n  storage.tavernHomeLocation = location\n  storage.tavernHomeArea = area\n  storage.atTavernHome = true\n  storage.companyFoundingActive = false\n  storage.companyActive = false\n  storage.companyStage = 'unfounded'\n  storage.companyDeeds = 0\n  storage.companyOfferOpen = false\n  storage.companyJobActive = false\n  storage.companyRecognitionPending = false\n  storage.companyHeadquartersImproved = false\n  storage.companyBackerChosen = false\n  storage.companySpecialistRecruited = false\n  storage.companyLastOfferTick = -999\n  storage.companyFirstClientSurfaced = false\n  storage.companyLegacyEstablished = false\n  effects.push({ type: 'write-boolean', key: 'tavern_owner', operator: 'set', value: true })\n  effects.push({ type: 'narrative-event-start', eventId: 'tavern_doors_open' })\n}",
