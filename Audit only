      "immunities": []
    },
    "mundane humanoid": {
      "name": "mundane humanoid",
      "description": "An ordinary mortal without supernatural defenses, such as a local, host, guard, outlaw, noble, worker, traveler, soldier, or cultist. Their identity comes from occupation, appetites, relationships, and social presence rather than supernatural power; they can still be bold, dangerous, charming, forceful, or larger than life.",
