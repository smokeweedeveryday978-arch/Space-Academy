    },
    "priest or blessed caster": {
      "name": "priest or blessed caster",
      "description": "A mortal priest, healer, shrine guardian, templar, champion, or blessed caster whose power comes from faith, sacred vows, or divine favor. Their beliefs are expressed through decisive action, mercy, glory, duty, judgment, rivalry, protection, or holy violence as appropriate to the character and faith.",
