        "The Gatehouse": {
          "description": "The fort's old gatehouse, a shell of broken stone walls and towers the reavers hold as their stronghold. A vault in its base holds the best of the plunder, and captives are penned in cells below. Stairs climb the towers to lookouts over the bog.",
          "paths": [
            "The Camp"
          ]
        }
