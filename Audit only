      "script": "storage.guilds = storage.guilds || {}\nstorage.guilds.blood = {\n  member: true,\n  rank: 'hired_blade',\n  deedCredits: 0,\n  lastCreditTick: -999\n}\nstorage.bloodMember = true\nstorage.bloodRank = 'hired_blade'\nstorage.bloodDeedCreditPending = false\nstorage.bloodPromotionPending = false\nstorage.bloodStandingQualified = false\nstorage.bloodQualifiedStanding = ''\nstorage.bloodPathChosen = false\neffects.push({ type: 'quest-init', operator: 'set', value: 'Earn Redblade Standing' })\neffects.push({ type: 'player-traits', target: 'allPlayers', operator: 'remove', value: 'Crimson Company Hired Blade' })\neffects.push({ type: 'player-traits', target: 'allPlayers', operator: 'remove', value: 'Crimson Company Redblade' })\neffects.push({ type: 'player-traits', target: 'allPlayers', operator: 'remove', value: 'Fledgling of the Blood' })\neffects.push({ type: 'player-traits', target: 'allPlayers', operator: 'remove', value: 'Blooded' })\neffects.push({ type: 'player-traits', target: 'allPlayers', operator: 'remove', value: 'Lord of the Blood' })\neffects.push({ type: 'player-traits', target: 'allPlayers', operator: 'add', value: 'Crimson Company Hired Blade' })",
