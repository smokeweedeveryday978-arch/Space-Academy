      "immunities": []
    },
    "storm elemental": {
      "name": "storm elemental",
      "description": "Living lightning, thunder, and charged wind. Storm creatures are weather with temperament — sudden, loud, magnificent, and gone; they gather where storms breed, at high crags and charged peaks, and in the wake of storm giants' moods. Their register is majesty and caprice, not malice. In combat: lightning strikes and thunderclaps (shock), speed no footwork answers; point and edge find nothing solid to catch, while mass can scatter the charged shape (piercing and slashing resist); grounding, shelter, and patience beat them where blades cannot (shock resist); raw arcane force tears at the charge holding them together (arcane vulnerability); they lose interest in what stops being interesting.",
      "vulnerabilities": [
        "arcane"
      ],
      "resistances": [
        "shock",
        "piercing",
        "slashing"
      ],
      "immunities": []
    },
    "trained warrior": {
      "name": "trained warrior",
      "description": "A bold martial combatant—adventurer, champion, knight, raider, duelist, or weapon-master—whose identity is expressed through a distinctive fighting style and an appetite for action, glory, rivalry, duty, or mastery. Such warriors often have a vivid social presence: proud, rowdy, theatrical, fierce, charming, competitive, or otherwise larger than life.",
