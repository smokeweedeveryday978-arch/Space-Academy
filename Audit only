    "great_lagoon_eye_approach_control": {
      "name": "great_lagoon_eye_approach_control",
      "recurring": true,
      "conditions": [
        {
          "type": "party-region",
          "operator": "equals",
          "value": "Great Lagoon"
        },
        {
          "type": "party-location",
          "operator": "notEquals",
          "value": "The Eye of God"
        },
        {
          "type": "action",
          "query": "The party attempts to reach, visit, enter, ascend to, travel to, fly to, climb to, teleport into, infiltrate, or force entry into the Eye of God above Caranthoria, including going to the Imperial Ascent to request admission or seek an audience there."
        }
      ],
      "script": "const actions = check({ type: 'action', query: '' })\nconst text = Array.isArray(actions) ? actions.join(' ') : String(actions || '')\nconst bypass = /\\b(climb\\w*|scal\\w*|fly|flight|wings?|teleport\\w*|blink\\w*|portal\\w*|sneak\\w*|infiltrat\\w*|disguis\\w*|impersonat\\w*|forg\\w*|smuggl\\w*|hid\\w*|stow\\w*|forc\\w*|break\\w*|storm\\w*|attack\\w*|assault\\w*|seiz\\w*|commandeer\\w*)\\b/i.test(text)\nconst authorized = storage.eyeOfGodAccessGranted === true\neffects = []\nif (bypass) {\n  effects.push({ type: 'story', instruction: 'The Eye has no bridge, stair, or open public route. The party is attempting an unauthorized ascent or bypass rather than routine travel. Resolve the chosen method using the action result: climbing a tether, flying through guarded airspace, teleporting, hiding with a work crew, forged credentials, or forcing the lift must not become effortless travel merely because the Eye is a map location. If the action fails, keep the party outside the Eye and show the concrete failure or interception. If a covert attempt succeeds, allow only the access actually earned and do not make the guards omniscient; detection may come later. An overt aerial breach, attack, or attempt to seize the lift draws an immediate legion response. Do not redirect this bypass attempt into a polite petition scene unless that is what the party actually chose.' })\n} else if (authorized) {\n  effects.push({ type: 'story', instruction: 'The party has established authorization to ascend to the Eye of God. At the Imperial Ascent, court clerks verify their names or summons, guards require weapons to be surrendered or declared, and an escort takes them by the enclosed tether-lift to the Ascension Hall. Their authorization grants only the audience, destination, and route for which it was issued; it is not unrestricted access to the citadel.' })\n} else {\n  effects.push({ type: 'party-location', operator: 'set', value: 'Caranthoria' })\n  effects.push({ type: 'party-area', operator: 'set', value: 'The Imperial Ascent' })\n  effects.push({ type: 'story', instruction: 'The party can approach the Eye only as far as the Imperial Ascent in Caranthoria. Do not narrate them crossing into or arriving inside the Eye. There is no bridge, stair, or public road upward: an enclosed imperial lift climbs one of the great brass tethers, and legion guards control its doors. The guards are formal, courteous, and immovable. They ask for a sealed invitation, imperial summons, recognized diplomatic authority, or an authorized escort. Without established authorization, they refuse ascent without attacking or arresting a cooperative visitor. They explain that a petition for audience must be lodged through the Imperial Palace or an appropriate prefect; they do not invent an invitation, accept a bribe, or allow persuasion alone to make them abandon their duty.' })\n}",
      "effects": []
    },
    "eye_of_god_interior_security": {
      "name": "eye_of_god_interior_security",
      "recurring": true,
      "conditions": [
        {
          "type": "party-location",
          "operator": "equals",
