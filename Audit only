    "Forge-town": {
      "name": "Forge-town",
      "complexityType": "complex",
      "basicInfo": "A prosperous artisan town of smiths, builders, jewelers, carvers, tinkers, and toolmakers serving Ardan's Watch and the League roads. Founded by dwarf, elf, and gnome crafters, it is home to the Guild of All Arts, whose golden hammer-and-chisel emblem is known throughout Silvervale.",
      "hiddenInfo": "The Guild of All Arts governs through its Council of Masters. Masters compete for commissions, apprentices, rankings, and the right to stamp work with the Guild seal. Dwarven smiths, gnome artificers, elven woodcarvers, halfling jewelers, and human builders all keep shops here, and talented outsiders are recruited hard. The quarterly Craft Fair draws buyers from across Larion and decides reputations for the year. Recent thefts of League-ordered arms and blessed fittings have everyone blaming everyone else; the Guild would rather hire adventurers quietly than admit how much work has gone missing.",
      "x": -4,
      "y": 28,
      "radius": 1,
      "region": "Whitecliff Downs",
      "detailType": "detailed",
      "areas": {
        "Town Square": {
          "description": "Paved plaza surrounded by workshops. A bronze statue of the Founder (a legendary dwarven smith) stands at center. Benches where masters gather to discuss techniques and gossip. Market stalls sell materials, tools, and finished works. The quarterly Craft Fair transforms this into a massive showcase.",
          "paths": [
            "The Guild of All Arts",
            "The Forge Quarter",
            "Woodworkers' Row",
            "The Steady Hand Inn"
          ]
        },
        "The Guild of All Arts": {
          "description": "Grand building where the Guild Council meets, contracts are negotiated, and apprentices register. Inside: trophy cases display past masterworks. The main hall hosts gatherings, competitions, and celebrations. Notice boards post available commissions and calls for help.",
          "paths": [
            "Town Square",
            "The Masters' Chamber",
            "The Archive"
          ]
        },
        "The Forge Quarter": {
          "description": "A street of smithies. Forges burn hot, apprentices work bellows, masters hammer steel into shape. Specializations vary - armor, weapons, tools, decorative work.",
          "paths": [
            "Town Square",
            "The Proving Yard"
          ]
        },
        "The Proving Yard": {
          "description": "Open area where finished weapons and armor are tested. Straw dummies, striking posts, and worn practice equipment. Masters demonstrate their work's quality here. Combat training offered to those who want to understand what they're making.",
          "paths": [
            "The Forge Quarter"
          ]
        },
        "Woodworkers' Row": {
          "description": "Carpenters, carvers, furniture makers, bowyers - if it's made of wood, someone here crafts it.",
          "paths": [
            "Town Square",
            "The Leather District",
            "The Timber Store"
          ]
        },
        "The Leather District": {
          "description": "Tanners, leatherworkers, and cobblers. The smell takes getting used to. Hides hang in various stages of treatment. Skilled hands cut and stitch leather into armor, boots, belts, bags.",
          "paths": [
