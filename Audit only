        "The Underbreaks": {
          "description": "A stretch where the ice has shattered into tilted slabs, pressure-ridges, and open breaks down into blue dark. Slabs lean against each other to form hollows and crawlspaces, and broken shapes are visible frozen in the walls of the deeper gaps — timber, iron, the edges of things the ice took. Sound carries strangely between the slabs.",
          "paths": [
            "The Floes"
          ]
        }
