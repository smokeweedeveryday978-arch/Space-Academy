        }
      ],
      "script": "const stages = { new_house: 'newly founded adventuring house', known: 'locally known adventuring company', established: 'established adventuring company', renowned: 'regionally renowned adventuring house', legendary: 'legendary adventuring house with an established legacy' }\nconst stage = stages[storage.companyStage] || storage.companyStage || 'newly founded adventuring house'\nconst jobState = storage.companyJobActive === true ? 'one accepted company field job is active' : storage.companyOfferOpen === true ? 'one client offer is open but not accepted' : 'no company field job is currently active'\nconst next = storage.companyStage === 'new_house' ? 'complete the first accepted field job and return home' : storage.companyStage === 'known' ? 'reach three completed deeds and establish one substantial headquarters facility' : storage.companyStage === 'established' ? 'reach six completed deeds and regional renown' : storage.companyStage === 'renowned' ? 'complete a defining major commission that establishes the company’s legacy' : 'choose great commissions and shape the company’s continuing legacy'\neffects.push({ type: 'story', instruction: 'Hidden adventuring-company state: the player’s stored home tavern is at ' + storage.tavernHomeLocation + ', ' + storage.tavernHomeArea + '. It is the seat of a ' + stage + ' with ' + (storage.companyDeeds || 0) + ' completed company deeds; ' + jobState + '. Its next milestone is to ' + next + '. Use the company name already established in the story and never invent a replacement. The keeper runs ordinary tavern operations and acts as dispatcher while the player leads important work in the field. Headquarters improvement: ' + (storage.companyHeadquartersImproved === true ? 'established' : 'not yet established') + '. Institutional posture chosen: ' + (storage.companyBackerChosen === true ? 'yes' : 'not yet') + '. Specialist recruited: ' + (storage.companySpecialistRecruited === true ? 'yes' : 'not yet') + '. Do not turn this path into accounting, supplies, drink service, or passive management.' })",
