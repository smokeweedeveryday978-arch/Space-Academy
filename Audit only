      "script": "const campaign = storage.towerDeadHunt\nif (!campaign || campaign.active !== true) { skip = true }\n\nif (!skip) {\n  const stage = campaign.stage || storage.towerDeadHuntStage || 'INITIATE_TRIALS'\n  const base = 'The Seven Named Dead are campaign bosses, not casual encounters. They may appear in briefings, records, omens, rumors, aftermath, or evidence, but do not put one physically in a scene until a specific case has been surfaced and the party reaches its root.'\n  const initiate = storage.towerShadowInitiateQualified === true ? ' The player has completed the one qualifying Initiate case and should return to the Pit for the Rite of Bonding. Do not assign a second required trial or a Named Dead yet.' : ' The player is an Initiate and must complete one supervised lesser case before the Rite. Surface an appropriate haunting, cursed relic, restless grave, possession, barrow, or lesser dead—not a Named Dead.'\n  const named = ' The player is a Shade-Bonded Inquisitor and may pursue the Seven. Each should first appear through signature trouble in the living world and then be ended at its root. The first three resolutions support Adept advancement; four further resolutions support Master advancement.'\n  const complete = ' All Seven are resolved. Treat this as a defining victory and do not reopen them as active threats.'\n  const stageText = stage === 'INITIATE_TRIALS' ? initiate : stage === 'NAMED_DEAD_HUNT' ? named : stage === 'COMPLETE' ? complete : ''\n  effects.push({ type: 'story', instruction: base + stageText })\n}",
