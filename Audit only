      ],
      "resistances": [
        "psychic",
        "piercing"
      ],
      "immunities": []
    },
    "aquatic creature": {
      "name": "aquatic creature",
      "description": "The creatures of river, marsh, lake, and sea: drowners, merrow, sirens, sea-devils, dragon turtles, giant crocodiles, and the kraken. Water is their weapon — they drag under, capsize, and vanish rather than duel; on dry land most are halved. Kinds: drowners are bloated man-shapes at weirs, fords, and millponds; merrow raid nets and drown fishermen; sirens sing ships onto the rocks and nest in wreck-fields; sea-devils rise at night from below and worship the deep; the dragon turtle tolls the strait or sinks the fleet; the kraken is the deep's titan and belongs to the Seadeep alone — never casual. Selkies are seal-folk of tragic bargains around a stolen skin: a story engine, not a combatant. In combat: ambush from beneath, grapple and drown (impact, piercing), retreat into depth when pressed; their water-heavy bodies swallow blunt force and flame (impact and fire resist); on land they lumber and lose; shock races through them from end to end (shock vulnerability).",
      "vulnerabilities": [
        "shock"
      ],
      "resistances": [
        "impact",
        "fire"
      ],
      "immunities": []
    },
    "arcane spellcaster": {
      "name": "arcane spellcaster",
      "description": "A mortal mage, wizard, illusionist, blood mage, runesmith, or ritualist whose defenses come from spellcraft rather than monstrous nature. Arcane spellcasters are distinguished by bold signature magic, magical ambition, and an active relationship with power expressed through daring, showmanship, rivalry, service, status, or hunger for mastery.",
      "vulnerabilities": [
