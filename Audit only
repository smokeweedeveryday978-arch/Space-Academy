        },
        "The Sunken Temple": {
          "description": "A stepped pyramid-temple half-collapsed into standing black water. The lower shrine is flooded and dark; the upper terraces are climbable, rising in broken tiers above the waterline. Drowned passages run back under the stone where the light gives out.",
          "paths": [
            "The Royal Court",
            "The Strangled Ways"
          ]
        },
        "The Toppled Spire": {
          "description": "A great tower fallen across the ruins, its length now a long bridge of broken floors and snapped stairs climbing from the ground to the high air. The upper chambers sit out of easy reach above the canopy, opened to the sky where the tower cracked. The vantage from the top reaches across the whole ruin-field.",
          "paths": [
            "The Royal Court",
            "The Strangled Ways"
          ]
        },
        "The Strangled Ways": {
          "description": "The streets and lesser plazas between the great structures, pried apart by roots and choked with stranglevine. Walls lean at angles and toppled statues of demonborn figures lie in the green, the cut stone showing through wherever the growth thins. The going is slow and the sightlines short.",
          "paths": [
            "The Royal Court",
            "The Sunken Temple",
            "The Toppled Spire"
          ]
        }
