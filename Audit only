    },
    "tavern_company_return_recognition": {
      "name": "tavern_company_return_recognition",
      "recurring": true,
      "conditions": [
        {
          "type": "read-boolean",
          "key": "atTavernHome",
          "operator": "equals",
          "value": true
        },
        {
          "type": "read-boolean",
          "key": "companyActive",
