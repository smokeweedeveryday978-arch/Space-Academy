    "House Saravel": {
      "name": "House Saravel",
      "x": -30,
      "y": 33,
      "radius": 1,
      "region": "Duchy of Drusavia",
      "detailType": "detailed",
      "known": true,
      "complexityType": "complex",
      "basicInfo": "House Saravel is the most glittering estate in the wealthy dales of Drusavia: a great house of pale stone and famous gardens, seat of the duchy's oldest noble family.",
      "hiddenInfo": "The Saravels are old blood. Before the Liberation, the Saravels, like the great houses of Drusavia, served the vampire lords — and when the Liberation came, Saravel turned on its masters, opened its gates, and fought. Every other great house of that age burned. Saravel was spared, and has been the first family of the dales ever since. House Saravel today is Lord Saravel, his lady, a crowd of siblings, cousins, and heirs, and the finest household staff in the dales. The family are pale, long-lived, and charming; they hunt, duel, gamble, and marry well, and the estate runs a nearly continuous season of balls, hunts, card evenings, and salons. Half the gentry of Drusavia owes the house money, favors, or a marriage, and invitations to Saravel are currency across the duchy. The family collects interesting people — champions, artists, hunters with names, clever strangers — and a capable guest who amuses them is fed, flattered, introduced to everyone worth knowing, and remembered. The family's private quarters, the oldest part of the house, admit no one but family — not guests, not staff, no exceptions.\n\nA house this old, rich, and watched has troubles it cannot air: debts of honor, relations gone to bad company, letters that must come home. The Saravels handle such things privately, and quietly hire discreet, capable outsiders to handle them — the kind of work that pays extremely well and is never spoken of again. A guest who proves both able and closemouthed will sooner or later be taken aside.",
      "areas": {
        "Saravel Grounds": {
          "description": "The approach to the great house: clipped hedges, pale gravel drives, fountains, and famous gardens kept perfect to the last leaf. Liveried staff meet visitors at the gates, and carriages come and go through the season.",
          "paths": [
            "Saravel Great Hall"
          ]
        },
        "Saravel Great Hall": {
          "description": "The heart of the house's entertaining: a long hall of pale stone and candlelight, portraits of two hundred years of Saravels, a musicians' gallery above and the famous table below. Doors open onto card rooms, the library, and the ballroom.",
          "paths": [
            "Saravel Grounds"
          ]
        }
