          ]
        },
        "The Floodline": {
          "description": "The lowest surviving section of the Forum, where the Flood's old waterline cuts across walls and columns far above the present floor. Submerged offices and sealed civic vaults lie below, reached through broken stairwells and narrow flooded passages.",
          "paths": [
            "The Civic Steps",
            "The Records Hall"
          ]
        }
