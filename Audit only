    "The Field of Valor": {
      "name": "The Field of Valor",
      "complexityType": "complex",
      "basicInfo": "Open ground west of Ardan's Watch where Tournament convenes for its public sessions. Colorful pavilions rise when representatives gather - silk tents for each house, merchant stalls, competition grounds. Champions demonstrate excellence through contests of arms, tests of knowledge, displays of skill. The field can accommodate thousands of spectators. Between sessions, it serves as common ground for fairs, celebrations, and military musters.",
      "hiddenInfo": "Tournament sessions transform the field into a temporary city where house retinues, merchants, performers, and spectators gather. Champions demonstrate excellence through contests that range from mounted combat to archery and athletics. The outcomes affect house standing and Council votes, making every contest politically significant. Some houses invest heavily in their Champions' success through training, equipment, and support. Others rely on natural talent. Accusations of cheating, bribery, or unfair judging create ongoing disputes. Tournament Masters maintain the grounds and arbitrate conflicts, but they cannot prevent all friction between ambitious houses.",
      "known": true,
      "x": 13,
      "y": 11,
      "radius": 1,
      "region": "Silvervale",
      "detailType": "detailed",
      "areas": {
        "The Grand Approach": {
          "description": "Wide road leading from the capital to the field. During Tournament, it fills with processions - house banners, armored retinues, merchant wagons. Stone markers line the route commemorating past Champions.",
          "paths": [
            "The Tournament Grounds",
            "The Pavilion Circle"
          ]
        },
        "The Tournament Grounds": {
          "description": "Central field where contests take place. Lists for mounted combat, archery ranges, dueling circles marked in white stone. Wooden stands for spectators can be assembled in days. The ground itself is sacred - no violence except in sanctioned contest. Its formally declared championship is recognized on the Grand Arena Circuit; the separate Grand Champion’s Contest is held in the Champions’ Ring.",
          "paths": [
            "The Grand Approach",
            "The Pavilion Circle",
            "The Champions' Ring",
            "The Festival Grounds"
          ]
        },
        "The Pavilion Circle": {
          "description": "Where great houses erect their silk pavilions during sessions. Each tent displays house colors and heraldry. Inside: weapons racks, armor stands, private chambers for Champions and their advisors. The arrangement shifts each session based on current standings.",
          "paths": [
            "The Grand Approach",
            "The Tournament Grounds",
            "The Masters' Manor"
          ]
        },
        "The Champions' Ring": {
          "description": "Raised circular platform of white stone where formal duels resolve parliamentary deadlock. No roof, no shade. When Champions fight here, thousands watch from the surrounding field. The stone remembers blood - old stains darken the center. A fighter who has won recognized championships at three distinct circuit arenas may be called here for the Grand Champion's Contest.",
          "paths": [
            "The Tournament Grounds"
          ]
        },
        "The Masters' Manor": {
          "description": "Fortified stone house where Tournament Masters live year-round. Contains archives of past contests, records of Champions, storage for standards and equipment. The Masters remain neutral in all house conflicts.",
          "paths": [
            "The Pavilion Circle",
            "The Festival Grounds"
          ]
        },
        "The Festival Grounds": {
          "description": "Open area where merchants set up temporary markets during Tournament. Food stalls, weapon vendors, fortune tellers, performers. Between official sessions, traveling fairs and military musters use this ground.",
          "paths": [
            "The Tournament Grounds",
            "The Masters' Manor",
            "The Commons"
          ]
        },
        "The Commons": {
          "description": "Rough camping ground for spectators, lesser retinues, and those who can't afford pavilion space. Tents crowd together without order. Pickpockets work the crowds. Gamblers run dice games. At night, cooking fires spread across the field like stars.",
          "paths": [
            "The Festival Grounds"
          ]
        }
