        },
        "The Reading-Courts": {
          "description": "Open mid-level courts set with long tables, study-carrels, cold tea, marked maps, copied inscriptions, and arguments in progress. Balconies overlook the galleries below, so every good discovery can be shouted down to someone who asked for it or someone who did not.",
          "paths": [
            "The Lower Galleries"
          ]
        },
        "The High Terraces": {
          "description": "Wind-touched marble terraces near the top of the library, where the shelves thin to rare works, locked stacks, and books that require permission or nerve. The whole Tarn lies below, and the oldest statues keep the upper stairs.",
          "paths": [
            "The Lower Galleries"
          ]
        }
