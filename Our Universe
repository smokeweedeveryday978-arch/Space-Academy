  "characterArchetypes": {
    "Working Professional": "A competent person with a real job, current task, off-duty life, and one practical limit. No secret or quest by default.",
    "Independent Operator": "A person who owns or rents tools, vehicle, shop, or vessel and thinks in costs, clients, maintenance, and reputation.",
    "Institutional Officer": "A person with defined authority, duties, superiors, records, and limits; rank is not personality.",
    "Student or Apprentice": "A learner with current curriculum, peers, money, embarrassment, skill gaps, and reasons for choosing the field.",
    "Frontier Resident": "A settled person whose competence grows from distance and shared infrastructure, not automatic toughness or isolation.",
    "Criminal Professional": "A person doing illegal work through incentives, contacts, procedure, and risk rather than theatrical evil or omniscience.",
    "Public Figure": "A visible person whose reputation, schedule, staff, privacy, and public role create both access and constraint.",
    "Companion Candidate": "A complete person with their own work, home, wants, boundaries, and reason to travel; never generated as a player satellite.",
    "Adult Entertainer": "A performer, host, sex worker, director, or venue professional with explicit services or art, boundaries, coworkers, income, and private life.",
    "Ship Crew": "A person defined by station, watch, competence, fatigue, pay, relationships, and what happens when their system fails."
  },
  "locationArchetypes": {
    "Working Station": "One clear economic function, housing, services, transit, maintenance, ordinary social life, and a reason ships stop.",
    "Trade Hub": "Visible prices, cargo flow, contracts, lodging, regulation, entertainment, labor, and several classes of access.",
    "Company Habitat": "Good services tied to employment, controlled access, housing, work, schools, shops, metrics, and real resident life.",
    "Frontier Settlement": "Water, power, food, repair, transport, governance, homes, work, local ecology, and distance from replacement supply.",
    "Ship Interior": "Areas follow function: bridge, engineering, habitation, cargo, medical, access, and mission modules according to class.",
    "Derelict": "Generate only after encounter or boarding; preserve scan uncertainty, physical cause, crew evidence, hazard, value, and legal status.",
    "Adult Venue": "Public threshold, stated services, worker control, pricing, security, privacy, healthcare, staff areas, and individual boundaries.",
    "Academy": "Teaching spaces, simulations, practical equipment, housing, evaluation, peers, support staff, and career connections.",
    "Natural Site": "Local geology, climate, ecology, access, law, visitors or workers, and no ruin or monster unless separately established."
  },
  "regionArchetypes": {
    "Core Galaxy": "Dense routes, old settlements, finance, law, education, repair, inequality, and many overlapping ordinary institutions.",
    "Trade Galaxy": "Ports, producers, carriers, markets, environmental rules, specialist cultures, and disputes over access rather than one empire.",
    "Industrial Frontier": "Mines, refineries, worker towns, company claims, independent operators, customs, piracy, and long supply chains.",
    "Sparse Frontier": "Few anchors, mobile communities, young colonies, surveys, delayed rescue, and no automatic ancient secret.",
    "Postwar Galaxy": "Reconstruction, veterans, borders, debris, treaties, families, new trade, and old evidence without permanent combat.",
    "Planetary Coast": "Ports, farms, reserves, cities, weather, local transport, ecology, work, and routes inland.",
    "Planetary Interior": "Settlements and industry grounded in water, food, geology, climate, transport, and local law.",
    "Ocean Region": "Surface and submerged routes, weather, ecology, farms, ports, pressure, rescue, and mixed-body architecture."
  }
