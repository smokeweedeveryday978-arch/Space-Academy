  "gameModes": {
    "Open Universe": {
      "name": "Open Universe",
      "description": "Balanced sandbox play across work, travel, relationships, trade, exploration, crime, politics, and conflict.",
      "instructions": "Follow the player’s chosen scale. Offer concrete local opportunities when they deliberately look for them, usually two or three with pay, time, place, and risk. Let quiet activity remain playable. Consequences persist, factions move, and danger can be real, but do not inject a crisis merely to make a scene important. Declined leads move on.",
      "difficulty": "medium",
      "askTheNarratorPrompt": "Ask about local work, prices, travel, nearby people, laws, your ship, open contracts, evidence, or what your character can reasonably know."
    },
    "Working Life": {
      "name": "Working Life",
      "description": "A lower-pressure life simulator centered on jobs, study, business, home, relationships, sex, community, and ordinary progress.",
      "instructions": "Treat shifts, classes, meals, repairs, shopping, dates, explicit adult intimacy, domestic choices, small business, and neighborhood ties as full play. Most days have no violence. Problems are proportional: bills, schedules, workplace friction, desire, family, mistakes, maintenance, and local opportunity. Keep dangerous events at the edge unless the player seeks them or an established consequence arrives.",
      "difficulty": "easy",
      "askTheNarratorPrompt": "Ask for jobs, classes, housing, shops, social places, dates, local routines, costs, or ways to improve your home and career."
    },
    "Frontier Pressure": {
      "name": "Frontier Pressure",
      "description": "A demanding mode where distance, damage, law, scarcity, and armed opposition matter without turning every scene into punishment.",
      "instructions": "Use existing hazards and resource constraints honestly. Repairs take parts and time; rescue may be distant; hostile actors exploit visible weakness; a failed plan changes terms. Do not create arbitrary betrayal, equipment failure, or attacks to maintain tension. Rest remains safe when earned or deliberately secured. Powerful rewards remain possible because their costs are operational, not because the narrator takes them back.",
      "difficulty": "hard",
      "askTheNarratorPrompt": "Ask about known hazards, reserves, escape routes, repair needs, legal exposure, opposition, or what preparation can lower the risk."
    },
    "Shared Crew": {
      "name": "Shared Crew",
      "description": "Multiplayer sandbox play organized around a crew without erasing individual actions or relationships.",
      "instructions": "Render every player action and organize the turn around one shared situation when possible. Do not invent consensus, captaincy, attraction, spending, or a group plan. Give each player meaningful consequence in proportion to their action rather than identical word count. Crew can split, disagree, pursue separate relationships, or reunite. Offer one clear shared option only when the scene genuinely needs orientation.",
      "difficulty": "medium",
      "askTheNarratorPrompt": "Ask about the crew’s current location, ship, roles, shared assets, individual positions, contracts, or unresolved disagreements."
    }
  },
  "authorSeeds": {
    "The Work": "Preserve the supplied character. Add one concrete task they are responsible for now and one standard by which they judge it. Do not invent a new profession, faction, crisis, or biography.",
    "The Want": "Preserve the supplied character. Clarify one present desire and one ordinary sign of progress. It may concern money, work, sex, love, status, rest, craft, travel, family, or belonging.",
    "The Bond": "Preserve the supplied character. Give one established or unnamed relationship a specific everyday rhythm. Do not force betrayal, sacrifice, romance, trauma, or dependence.",
    "The Pleasure": "Preserve the supplied character. Add one chosen pleasure that can appear in play: food, sport, sex, media, craft, fashion, bathing, machines, music, collecting, quiet, or company.",
    "The Friction": "Preserve the supplied character. Add one manageable contradiction between two real priorities. Do not turn it into a conspiracy, secret crime, or life-defining trauma.",
    "The Limit": "Preserve the supplied character. Add one practical boundary, blind spot, resource limit, schedule pressure, or thing they will not do. A limit is not automatically a flaw to overcome."
  },
