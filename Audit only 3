        {
          "type": "skill",
          "variable": "Enchantment",
          "amount": 10
        }
      ],
      "bonus": 10,
      "cooldown": 0
    },
    "SECOND LEVEL - Silvery Barbs": {
      "name": "SECOND LEVEL - Silvery Barbs",
      "description": "You loose a stream of magical verbal barbs at a creature that has just succeeded in an action, twisting their confidence into sudden doubt and forcing them to repeat the attempt. The distraction also grants a nearby ally a flash of magical advantage on their next action.",
      "requirements": [
        {
          "type": "skill",
          "variable": "Enchantment",
          "amount": 10
        }
      ],
      "bonus": 10,
      "cooldown": 0
    },
    "THIRD LEVEL - Fast Friends": {
      "name": "THIRD LEVEL - Fast Friends",
