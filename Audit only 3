  "npcTypes": {
    "Goblin Raider": {
      "name": "Goblin Raider",
      "vulnerabilities": [
        "fire",
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A small, wiry green-skinned humanoid with yellow eyes and a cruel grin, armed with crude scimitars and a shield made from scavenged wood. Goblin raiders hunt in cowardly packs, preferring overwhelming numbers over honourable combat and fleeing the moment a fight turns against them. Their stench precedes them, a mix of unwashed fur and rotted meat clinging to their ill-fitting armour. They cackle with nervous laughter even in battle, their courage entirely dependent on the strength of their nearest companion."
    },
    "Goblin Archer": {
      "name": "Goblin Archer",
      "vulnerabilities": [
        "fire",
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A lean, sharp-eyed goblin perched in trees or atop crumbled walls, armed with a shortbow and a quiver of black-fletched arrows tipped with stolen iron. These skirmishers favour ambush and harassment, peppering foes from range before their melee kin swarm in to finish the work. They communicate through sharp whistles and bird calls, coordinating strikes with surprising precision. Their kills are notched into their bowstaves as small, ritual tallies of pride."
    },
    "Goblin Hexer": {
      "name": "Goblin Hexer",
      "vulnerabilities": [
        "fire",
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A wizened, hunched goblin draped in bone fetishes and the skulls of small creatures, muttering curses through blackened teeth. Hexers channel petty magic through crooked fingers, hurling sparks of fire, shrieking banshee-wails, and binding enemies with tangles of shadow. They are treated as prophets within their tribes despite their barely-functional spellcraft, their every word interpreted as omen. The smell of burnt hair and sour herbs follows them everywhere."
    },
    "Goblin Boss": {
      "name": "Goblin Boss",
      "vulnerabilities": [
        "fire",
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A larger, scarred goblin with a piercing bark of command and looted armour stitched together from multiple fallen foes. Bosses rule through sheer meanness, keeping lesser goblins in line with casual violence and bribes of shiny loot. They wield a heavier weapon than their kin — typically a flail, bastard sword, or stolen polearm — and fight with genuine martial skill rather than flailing aggression. Their cunning rivals that of a human tactician, though they disguise it beneath crude laughter."
    },
    "Hobgoblin Legionnaire": {
      "name": "Hobgoblin Legionnaire",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A tall, broad-shouldered goblinoid with rust-red skin, sharp canines, and the rigid bearing of a disciplined soldier. Hobgoblins fight in tight formations with shield walls, coordinated volleys, and the grim efficiency of career warriors. Their armour is lacquered black iron and their eyes blaze orange with martial fervour, each kill contributing to their personal honour record. Desertion is punished by the entire legion, and loyalty to the unit surpasses loyalty to kin."
    },
    "Hobgoblin Warlord": {
      "name": "Hobgoblin Warlord",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An imposing hobgoblin general in ornate black armour etched with victory runes, carrying a legendary blade that has tasted a thousand lives. Warlords command entire legions through sharp voice and sharper tactics, their strategies drawn from decades of ruthless campaigning. They respect worthy enemies and demand formal surrender before sparing lives, but offer no mercy to cowards or oath-breakers. Their ambition extends to carving empires from the bones of softer races."
    },
    "Bugbear Ambusher": {
      "name": "Bugbear Ambusher",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A hulking goblinoid nearly seven feet tall with coarse brown fur, yellow tusks, and the uncanny ability to move in absolute silence despite its bulk. Bugbears prefer ambush above all else, striking from shadows with heavy morningstars before their prey can react. They delight in cruelty as much as killing, savouring the terror in their victims' eyes. Their reek of wet fur and old blood is the only warning most travellers receive."
    },
    "Orc Berserker": {
      "name": "Orc Berserker",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "A muscle-bound grey-green orc with tusks jutting from a scarred jaw, working itself into a foaming battle-rage before the fight even begins. Berserkers charge headlong into combat without regard for their own wounds, swinging enormous axes in wide, devastating arcs. Their fury grants them near-immunity to pain, and they continue fighting long after mortal wounds should have felled them. The scars covering their bodies tell stories of battles no lesser warrior would have survived."
    },
    "Orc Shaman": {
      "name": "Orc Shaman",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A grizzled orc draped in bone fetishes and the teeth of fallen enemies, eyes rolling white in trance-states between chants. Shamans commune with their bloody gods of war and storm, calling down lightning, strengthening their warband's muscles, and cursing enemies with weakness. Their authority within the tribe is second only to the chieftain, and often their prophecies determine when the horde marches. Blood stains their knotted braids permanently — some ritual, some merely convenient."
    },
    "Orc Warchief": {
      "name": "Orc Warchief",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "A towering orc warrior in armour fashioned from the bones and skin of great beasts, wielding a two-handed axe taller than most humans. Warchiefs rule through raw physical dominance, personally slaying anyone who questions their right to lead. They possess surprising strategic cunning beneath their brutality, knowing when to strike and when to retreat to preserve the horde. Their voice alone can rally fleeing warriors back into the fight."
    },
    "Kobold Scout": {
      "name": "Kobold Scout",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A small reptilian humanoid with bronze scales, a rat-like tail, and large ears that twitch at every sound in the dark. Kobold scouts are master trap-makers and tunnel-fighters, using their size and cunning to turn cramped dungeons into death-mazes. They worship dragons as gods and dream of finding a true wyrm to serve. Individually they are easily dispatched, but dozens coordinating through tunnels can drag down far larger foes."
    },
    "Kobold Dragonshield": {
      "name": "Kobold Dragonshield",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "An elite kobold bearing a draconic standard and painted in the heraldic colours of the tribe's dragon patron. Dragonshields are the kobold warrior aristocracy, wielding proper steel and wearing scaled armour etched with sacred wyrm-runes. They lead charges with fanatic devotion, believing their dragon god watches every strike. A defeated dragonshield's final words are always a plea to their master, not for mercy."
    },
    "Kobold Sorcerer": {
      "name": "Kobold Sorcerer",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A kobold born with strong draconic blood, its scales shimmering in the colour of its ancestor wyrm and its eyes slit-pupiled like a reptile's. Sorcerers exhale small bursts of their heritage element — fire, frost, acid — and are treated with superstitious awe by their kin. They are often spared labour and raised as priest-kings, trained from hatching to channel their innate magic. Their pride borders on contempt even for fellow kobolds."
    },
    "Gnoll Hunter": {
      "name": "Gnoll Hunter",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A tall, hyena-headed humanoid with matted fur, yellow eyes, and a perpetual bone-wrenching hunger. Gnoll hunters run in cackling packs, driving prey to exhaustion before tearing them apart with claws and crude weapons. They are servants of a demon lord of famine, and every kill is a twisted offering. They leave behind butchery-yards of gnawed bones as grim territorial markers."
    },
    "Gnoll Fang of Yeenoghu": {
      "name": "Gnoll Fang of Yeenoghu",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A champion gnoll marked personally by the demon lord of slaughter, its fur streaked black and its eyes burning with infernal recognition. Fangs possess supernatural ferocity, regenerating wounds as long as they continue killing and spreading the blood-madness to lesser gnolls. They are the focal points of gnoll raids, and slaying one often breaks the pack's morale. Their voices warp into demonic snarls when they invoke their patron's name."
    },
    "Lizardfolk Warrior": {
      "name": "Lizardfolk Warrior",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "disease"
      ],
      "description": "A tall reptilian humanoid with mottled green scales, sharp teeth, and a long muscular tail that lashes as it moves. Lizardfolk warriors fight with practical utility rather than malice, wielding bone spears and shields of turtle shell. They view outsiders through a pragmatic alien lens, weighing conflict against benefit with no sentiment for mercy or honour. They eat the fallen without distinction between enemy and ally."
    },
    "Lizardfolk Shaman": {
      "name": "Lizardfolk Shaman",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "disease"
      ],
      "description": "An elder lizardfolk adorned in the feathers and scales of powerful swamp creatures, communing with the spirits of the marshland. Shamans wield primal magic that summons swarms of biting insects, whips up rolling fog banks, and calls forth crocodile-spirits to swim through the mud. They serve as advisors to their tribe's king and maintain the balance between cold-blooded pragmatism and ancient spiritual obligation. Their eyes are milky with second-sight."
    },
    "Dragon Wyrmling": {
      "name": "Dragon Wyrmling",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A dragon barely large enough to be called one, the size of a large dog with scales that have not yet hardened to their adult lustre. Wyrmlings are dangerous predators but lack the cunning and sheer power of their elders, still prone to petulant tantrums and simple appetites. They can breathe their signature element in short, fierce gouts that can still incinerate unarmoured foes. Their hoards are small — usually a single stolen treasure they cling to with frantic jealousy."
    },
    "Young Dragon": {
      "name": "Young Dragon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An adolescent dragon the size of a cart horse, its scales fully hardened and its wings broad enough to carry it on long flights. Young dragons are in their prime aggressive phase, establishing territory and testing their power against the world with reckless confidence. They command respectable magic alongside their breath weapon and have begun accumulating serious hoards. Their intelligence rivals a human scholar's, though their wisdom remains underdeveloped."
    },
    "Adult Dragon": {
      "name": "Adult Dragon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A fully grown dragon the size of a small building, radiating the frightful presence that makes even seasoned warriors tremble before striking. Adults have mastered their breath weapon and a substantial library of dragon magic, approaching any engagement with calculating patience. Their hoards fill caverns with treasure hoarded across a century of reigning terror over a region. Their voices carry the rumble of geological force even in quiet conversation."
    },
    "Ancient Dragon": {
      "name": "Ancient Dragon",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "A colossal wyrm of immense age whose scales have grown to armour plates and whose horns spiral like twisted trees. Ancient dragons possess the wisdom of centuries and magic rivalling the greatest mortal archmages, speaking of events a thousand years past as though yesterday. Their hoards are legendary, their lairs warp reality around them, and their presence alone can shake the confidence of champions. They view mortals the way mortals view insects — interesting, occasionally useful, never equals."
    },
    "Red Dragon": {
      "name": "Red Dragon",
      "vulnerabilities": [
        "cold"
      ],
      "resistances": [],
      "immunities": [
        "fire"
      ],
      "description": "The most iconic and vicious of chromatic dragons, with scales of deep crimson and a roaring breath of liquid fire that can melt stone. Red dragons are consumed by avarice and vanity, measuring their worth in the size of their treasure hoard and the number of kingdoms they have burned. They prefer volcanic lairs where the heat suits their constitution. They are the apex of greed made flesh, and negotiate only when victory would cost more than yielding."
    },
    "Blue Dragon": {
      "name": "Blue Dragon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "lightning"
      ],
      "description": "A proud, territorial chromatic dragon with electric-blue scales and a single backward-curving horn, its breath a crackling lance of lightning. Blue dragons prefer desert lairs where they can sense vibrations through sand for miles around. They are methodical planners who construct entire fiefdoms of enthralled servants below them. They consider themselves aristocrats of the dragon kind and resent being spoken to without proper deference."
    },
    "Green Dragon": {
      "name": "Green Dragon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison"
      ],
      "description": "A cunning, deceptive chromatic dragon with forest-green scales and a breath of corrosive toxic vapour that withers flesh and plant alike. Green dragons prefer to dominate through manipulation rather than open battle, cultivating networks of blackmail and corrupt alliances. They lair in deep old forests where their scales blend seamlessly with the canopy. Their honeyed voices and elaborate schemes make them more akin to devils than their chromatic kin."
    },
    "Black Dragon": {
      "name": "Black Dragon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "acid"
      ],
      "description": "A cruel, vicious chromatic dragon with obsidian-black scales and a breath of flesh-dissolving acid. Black dragons delight in the suffering of their prey, often playing with victims for hours before ending them. They lair in foetid swamps and decaying ruins, surrounded by the grisly evidence of their pastimes. Their sadism is unique even among evil dragons, driven by genuine enjoyment rather than philosophical malice."
    },
    "White Dragon": {
      "name": "White Dragon",
      "vulnerabilities": [
        "fire"
      ],
      "resistances": [],
      "immunities": [
        "cold"
      ],
      "description": "The most bestial of chromatic dragons, with pearly-white scales and a breath of absolute cold that flash-freezes everything it touches. White dragons are the least cunning of their kind, driven primarily by hunger and territorial aggression. They lair in glaciers and icy mountain peaks, hoarding simple treasure like polished gemstones that catch the light. They speak draconic but rarely have anything complex to say."
    },
    "Gold Dragon": {
      "name": "Gold Dragon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "fire"
      ],
      "description": "A regal, noble metallic dragon with brilliant gold scales and a breath of purifying fire that can also incapacitate rather than kill. Gold dragons view themselves as protectors of the innocent and often take mortal disguises to wander among the peoples they watch over. They are austere, dutiful, and occasionally sanctimonious, but genuinely benevolent. Their hoards are gathered only from those who died without heirs, and they give freely to causes of justice."
    },
    "Silver Dragon": {
      "name": "Silver Dragon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "cold"
      ],
      "description": "A friendly, personable metallic dragon with gleaming silver scales and a breath of paralysing cold. Silver dragons adore mortal company and often take humanoid form for decades at a time, raising families and holding mundane professions before returning to their draconic shape. They lair on cloud-shrouded mountains and treat hospitality as sacred. They are perhaps the most approachable of all dragons, though still terrifying when roused."
    },
    "Bronze Dragon": {
      "name": "Bronze Dragon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "lightning"
      ],
      "description": "A curious, adventurous metallic dragon with bronze-green scales and a breath of repulsive lightning that also can push enemies back. Bronze dragons are fascinated by military strategy and naval affairs, often serving as advisors to coastal kingdoms and rulers. They lair near oceans and take to war with evil powers with genuine enthusiasm. They are perhaps the most politically engaged of dragons."
    },
    "Beholder": {
      "name": "Beholder",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A floating orb of paranoid flesh with a central maw of jagged teeth and ten eyestalks that writhe atop its bulbous body. Beholders are aberrations of alien intelligence, each one believing itself the only true example of its kind and viewing all others as aberrant. Their eye rays unleash devastating magical effects — disintegration, petrification, fear, telekinesis, death itself. They dwell in elaborate lairs reshaped to match their paranoid visions of correct architecture."
    },
    "Mind Flayer": {
      "name": "Mind Flayer",
      "vulnerabilities": [],
      "resistances": [
        "psychic"
      ],
      "immunities": [],
      "description": "A tall, octopus-headed humanoid with purple skin and four writhing facial tentacles hiding a razor-edged beak. Mind flayers live in subterranean cities ruled by alien god-brains, considering themselves the rightful masters of all sentient life. Their telepathic powers tear through mortal defences, and their signature attack extracts and devours their victims' brains in a single horrifying moment. They view all other species as livestock or slaves."
    },
    "Aboleth": {
      "name": "Aboleth",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "psychic"
      ],
      "description": "A serpentine fish-creature the size of a whale, with tentacles, a flat fish-tail, and three slit eyes stacked on its forehead. Aboleths remember every moment of every life their ancestors have ever lived, and know the world predates the gods themselves. They enslave mortals through a mind-warping slime that reshapes flesh into amphibious horror. Their arrogance is cosmic — they have been ancient since before humans existed."
    },
    "Lich": {
      "name": "Lich",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "magical",
        "cold",
        "lightning"
      ],
      "immunities": [
        "necrotic",
        "poison",
        "disease",
        "fear",
        "charm"
      ],
      "description": "A shrivelled, robe-clad corpse with eyes that glow in empty sockets and a phylactery hidden far away containing its bound soul. Liches are wizards who embraced undeath to achieve immortality, trading warmth and companionship for centuries of uninterrupted magical research. Their spells are varied and devastating, their intellects cold and calculating. Destroying a lich without finding its phylactery merely delays it — the soul reforms within days, and the lich returns for slow, patient vengeance."
    },
    "Vampire Lord": {
      "name": "Vampire Lord",
      "vulnerabilities": [
        "radiant",
        "radiant",
        "fire"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing",
        "cold",
        "necrotic"
      ],
      "immunities": [],
      "description": "A pale, aristocratic undead wearing the finery of the century in which they died, with inhuman beauty masking predatory hunger. Vampire lords rule domains of terror from their ancestral castles, gathering thralls, spawn, and servitors through charm and blood pacts. Their physical might rivals an ogre's, their speed a panther's, and their cunning that of a centuries-old tactician. Running water, radiant, and blessed ground are among the few things that truly threaten them."
    },
    "Ghost": {
      "name": "Ghost",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "poison",
        "disease",
        "charm",
        "fear"
      ],
      "description": "The translucent, lingering spirit of a mortal who died with unfinished business or violent trauma, trapped between worlds. Ghosts manifest with emotional echoes of their final moments — rage, grief, obsession — and attempt either to resolve their lingering purpose or to inflict their suffering on the living. They can possess creatures, age victims with a chill touch, and pass through solid walls. Truly laying a ghost to rest requires addressing whatever keeps it bound."
    },
    "Wraith": {
      "name": "Wraith",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing",
        "cold",
        "necrotic"
      ],
      "immunities": [
        "poison",
        "disease",
        "charm"
      ],
      "description": "A humanoid silhouette of pure malevolent shadow, its eyes two points of cold starlight in an otherwise featureless form. Wraiths drain the life from their victims with a touch, and those slain by them rise as lesser undead specters bound to the wraith's will. Unlike ghosts, they have no unfinished business — they are hatred given form, the residue of evil that refused oblivion. They haunt the places of their greatest cruelties in life."
    },
    "Zombie": {
      "name": "Zombie",
      "vulnerabilities": [
        "radiant",
        "fire"
      ],
      "resistances": [],
      "immunities": [
        "poison",
        "charm",
        "fear"
      ],
      "description": "A shambling corpse reanimated by necromantic energy, its flesh putrefying, its eyes clouded and sightless. Zombies are mindless servants that follow only the simplest commands, but their numbers and inability to feel pain make them genuine threats in mass. They continue to attack even when grievously wounded, stopping only when their bodies are physically destroyed. The stench of rot follows them like a fog."
    },
    "Skeleton Warrior": {
      "name": "Skeleton Warrior",
      "vulnerabilities": [
        "bludgeoning",
        "radiant"
      ],
      "resistances": [
        "piercing",
        "cold"
      ],
      "immunities": [
        "poison",
        "charm",
        "fear"
      ],
      "description": "A clattering frame of animated bones wrapped in the remains of rotted armour, wielding the sword it carried in life. Skeletons retain the basic combat muscle-memory of their former selves, making them more dangerous than mindless zombies despite their fragile frames. They show no pain, no hesitation, and no mercy, falling to dust only when bludgeoned or dismembered. Their hollow eye sockets sometimes glow with faint green necromantic light."
    },
    "Ghoul": {
      "name": "Ghoul",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [
        "poison",
        "charm",
        "fear",
        "disease"
      ],
      "description": "A hunched, grey-skinned undead with elongated claws, blackened teeth, and the twisted features of a human corpse consumed by ravenous hunger. Ghouls retain just enough intelligence to plan ambushes and work in packs, driven by an unending craving for living flesh. Their paralytic claws can freeze victims in place with a single scratch, allowing the ghoul to feast at leisure. They are often elves cursed for cannibalistic sins — though this is little comfort to their prey."
    },
    "Mummy Lord": {
      "name": "Mummy Lord",
      "vulnerabilities": [
        "fire"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing",
        "magical"
      ],
      "immunities": [
        "poison",
        "disease",
        "charm",
        "fear"
      ],
      "description": "The preserved corpse of an ancient king wrapped in ritual linens, animated by temple magic and burning eyes that see across millennia. Mummy lords were mighty priests and rulers in life who refused to relinquish their thrones in death, reigning eternally over buried kingdoms. Their touch carries a rotting curse that withers flesh into dust, and their gaze can strike the unprepared with heart-stopping terror. They command lesser mummies and cultists from their preserved tombs."
    },
    "Banshee": {
      "name": "Banshee",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing",
        "cold",
        "necrotic"
      ],
      "immunities": [
        "poison",
        "charm",
        "fear"
      ],
      "description": "The undead spirit of an elven woman whose vanity turned to self-loathing in death, a pale and translucent figure of mournful beauty. Banshees haunt the places of their humiliation, their keening wail powerful enough to stop mortal hearts through sheer grief made sound. They hate all living things, but particularly the young and beautiful, whose futures they will never have. Only by laying to rest whatever regret bound them in death can they be freed."
    },
    "Ogre": {
      "name": "Ogre",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A towering, thick-limbed humanoid ten feet tall with warty skin, heavy-lidded eyes, and limited intelligence. Ogres are brutish but not mindless, serving as muscle for smarter creatures or dominating smaller humanoids through raw force. They wield tree-trunks as clubs and wear armour cobbled together from wagon wheels and cookware. Their appetites are enormous — an ogre raid is as much about food as pillage."
    },
    "Troll": {
      "name": "Troll",
      "vulnerabilities": [
        "fire",
        "acid"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A gangly, rubber-limbed creature with mossy green skin, a long sharp nose, and a voracious hunger for any kind of meat. Trolls are terrifying because of their regeneration — wounds close and limbs regrow within seconds unless the damage is sealed with fire or acid. They are stupid but cunning in the way predators are cunning, knowing when to press an attack and when to flee. Severed troll limbs sometimes continue to crawl independently until destroyed."
    },
    "Hill Giant": {
      "name": "Hill Giant",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A massive, round-bellied giant with a low sloped forehead and a permanent greasy stain of food around its mouth. Hill giants are the least intelligent of their kind, driven almost entirely by hunger and laziness. They raid farms and villages for livestock and grain, preferring easy targets over genuine challenges. Their crude greatclubs are often just uprooted oak trees."
    },
    "Fire Giant": {
      "name": "Fire Giant",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "fire"
      ],
      "description": "A disciplined, industrious giant with soot-black skin, flaming red hair, and the bearing of a stern craftsman-warrior. Fire giants dwell in volcanic forges where they craft extraordinary weapons and armour, including some of the finest magical blades outside elven realms. They value order, strength, and martial honour, with strict hierarchies based on personal prowess. Their greatswords can cleave through trees with casual ease."
    },
    "Frost Giant": {
      "name": "Frost Giant",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "cold"
      ],
      "description": "A towering blue-skinned giant with a wild shaggy mane of ice-white hair and the bellowing laughter of a creature that has never feared death. Frost giants are raiders and warriors who view combat as the truest expression of worth, raiding settlements with longboats across frozen seas. They drink prodigiously, boast constantly, and settle disputes with weapon-fasts that often end in lethal conclusions. Their axes drip frost on impact."
    },
    "Stone Giant": {
      "name": "Stone Giant",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "A lean, grey-skinned giant with graceful proportions and a thoughtful, contemplative manner that belies its massive stature. Stone giants dwell in deep mountain caves where they carve beautiful art into bare rock and consider the surface world a strange dream. They are reclusive and mostly peaceful, but ferocious when their ancestral homes are violated. They can hurl boulders with terrifying accuracy across enormous distances."
    },
    "Cloud Giant": {
      "name": "Cloud Giant",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An imperious, elegantly dressed giant with alabaster skin and the bearing of a noble from a vanished empire. Cloud giants dwell in floating castles hidden in the mountain clouds, rarely interacting with lesser races except in carefully managed encounters. They are hedonists and collectors, amassing libraries, art galleries, and exotic gardens in their sky-homes. Their magical ability and refined taste make them perhaps the most sophisticated of giant-kind."
    },
    "Storm Giant": {
      "name": "Storm Giant",
      "vulnerabilities": [],
      "resistances": [
        "lightning",
        "thunder"
      ],
      "immunities": [],
      "description": "The most powerful of giants, a towering figure over twenty feet tall with violet-tinged skin, eyes of shifting electric colour, and hair that crackles with static. Storm giants dwell in remote underwater palaces or impossibly high mountain peaks, detached from mortal affairs by centuries of peaceful solitude. They are seers and sages who rarely act, but when they do the world shudders. Their voices carry with them the rumble of thunder itself."
    },
    "Minotaur": {
      "name": "Minotaur",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A hulking humanoid with the head and horns of a bull, broad shoulders, and the disciplined bearing of a career warrior. Minotaurs are frequently encountered as maze-guardians for ancient temples or as mercenaries seeking worthy opponents. They never lose their way, an instinctive sense of direction built into their blood. They honour those who defeat them and despise those who flee without fighting."
    },
    "Centaur": {
      "name": "Centaur",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A graceful being with the upper body of a human and the muscular lower body of a great horse, often adorned with tribal paint and feathered hair ornaments. Centaurs dwell in rolling plains and open meadows, living in small nomadic tribes that fiercely protect their traditional lands. They are skilled archers and spear-fighters, combining the speed of a horse with the dexterity of a humanoid. Their honour codes are strict but their hospitality can be extraordinary to those who approach respectfully."
    },
    "Satyr": {
      "name": "Satyr",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A mischievous fey creature with the upper body of a handsome humanoid and the furred lower legs of a goat, complete with cloven hooves and small curling horns. Satyrs are hedonists, musicians, and tricksters who inhabit the borderlands between mortal realms and the Feywild. Their pipes and songs carry enchantment, causing listeners to dance uncontrollably or reveal their secrets. They are rarely malicious but often careless, and their games can spiral into real danger."
    },
    "Dryad": {
      "name": "Dryad",
      "vulnerabilities": [
        "fire"
      ],
      "resistances": [],
      "immunities": [
        "charm"
      ],
      "description": "A fey spirit of the forest bound to a specific ancient tree, appearing as a beautiful humanoid woman with hair of leaves and skin patterned like bark. Dryads seldom travel far from their bonded tree, which is also their source of life — destroying the tree kills the dryad, and harming the dryad wounds the tree. They are guardians of their woodland domains, capable of commanding plant life and charming intruders into forgetting their purpose. Their beauty is otherworldly and unsettling."
    },
    "Nymph": {
      "name": "Nymph",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "charm"
      ],
      "description": "An impossibly beautiful fey being associated with a specific natural location — a spring, a waterfall, a hidden grove — whose mere presence can overwhelm mortal minds. Nymphs are immortal, playful, and profoundly alien, their emotions shifting like weather. Their true beauty can strike a mortal blind or mad if witnessed unprepared. They are neither good nor evil but utterly natural, indifferent to mortal morality."
    },
    "Pixie": {
      "name": "Pixie",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A tiny winged fey the size of a cat, with gossamer wings, delicate features, and an impish sense of humour. Pixies are almost impossible to see unless they wish to be, capable of turning invisible, flying silently, and casting a repertoire of enchantment magic. They love pranks, songs, and gifts, but their sense of what constitutes fair treatment is utterly alien to mortals. Angering a pixie can bring weeks of small, unsolvable disasters."
    },
    "Hag": {
      "name": "Hag",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An ancient, grotesque fey crone with twisted features, gnarled hands, and black eyes that have seen the undoing of kingdoms. Hags come in three principal varieties — green hags in swamps, sea hags in tidal caves, and night hags that walk through dreams — each more terrible than the last. They collect secrets, curses, and cruelties as other creatures collect coins. Three hags bound together in a coven can challenge even archmages."
    },
    "Devil": {
      "name": "Devil",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "fire",
        "poison"
      ],
      "description": "A fiend from the Nine Hells, bound by rigid infernal law and driven by the corruption of mortal souls through bargains and temptations. Devils range from lesser imps that spy and scheme to towering pit fiends that command legions. Every devil is a master negotiator, seeking loopholes in any contract and demanding steep prices for even small favours. They are the most dangerous fiends precisely because they work within the letter of the law."
    },
    "Imp": {
      "name": "Imp",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold"
      ],
      "immunities": [
        "fire",
        "poison"
      ],
      "description": "A tiny, red-skinned devil with bat wings, a barbed tail dripping with infernal venom, and a sly, needling voice. Imps serve as familiars to warlocks and evil spellcasters, spying on enemies and whispering corruption into their masters' ears. They can turn invisible at will and shapeshift into small animals, making them ideal informants. Their bargains are small in scope but designed to escalate into soul-ruining commitments."
    },
    "Pit Fiend": {
      "name": "Pit Fiend",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "fire",
        "poison"
      ],
      "description": "An enormous winged devil with red scales, black bat-wings, and a reek of brimstone that poisons the air around it. Pit fiends are generals of infernal legions, commanding thousands of lesser devils in the wars of the Nine Hells. Their mere presence inspires paralysing terror in mortals, and their magical might rivals archmages. They negotiate only for soul-commitments of the highest value, and rarely appear without elaborate infernal protocol."
    },
    "Demon": {
      "name": "Demon",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "fire",
        "lightning"
      ],
      "immunities": [
        "poison"
      ],
      "description": "A chaotic fiend from the Abyss, driven by mindless hatred of all existence rather than any coherent philosophy. Demons range from wretched, scrambling dretches to towering balors of immense power. Unlike devils they honour no contracts, keep no oaths, and exist only to destroy, consume, and corrupt. Their forms are nightmarish, often asymmetrical, and their presence warps the land into mockeries of life."
    },
    "Balor": {
      "name": "Balor",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "lightning",
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "fire",
        "poison"
      ],
      "description": "A towering demon lord of the Abyss, a winged warrior of black muscle and living flame wielding a burning whip and a bastard sword of primordial fire. Balors are generals of the demon legions, as close to pure destructive will as the Abyss can shape. They radiate a sheath of searing flame that ignites any who approach, and their mere death-throes can incinerate those who slew them. They answer only to the demon princes themselves."
    },
    "Succubus": {
      "name": "Succubus",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "fire",
        "lightning",
        "poison"
      ],
      "immunities": [],
      "description": "A shape-shifting fiend capable of appearing as an impossibly beautiful humanoid of any race or gender, seducing mortals into slow moral corruption. Succubi do not typically engage in direct combat, preferring to manipulate and slowly turn victims toward dark paths over years of intimate influence. Their kiss drains life and their true form is unsettlingly androgynous with bat wings and tail. They collect souls through patient, tender damnation."
    },
    "Angel": {
      "name": "Angel",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "radiant",
        "charm",
        "fear"
      ],
      "description": "A radiant celestial being sent from the upper planes as messenger, warrior, or guardian of mortals. Angels appear as impossibly beautiful humanoids with multiple wings and eyes of pure starlight, their voices harmonising as though a chorus. They speak with absolute moral certainty and intervene only when direct action is required by the cosmic order. Their weapons carry the fire of divine righteousness, and their mere presence can drive evil into paralysis."
    },
    "Deva": {
      "name": "Deva",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "radiant",
        "charm",
        "fear"
      ],
      "description": "A messenger-angel of the upper planes, appearing as a winged humanoid of almost painful beauty with skin that faintly glows. Devas are the diplomats and scouts of the celestial realms, often sent to guide mortal champions or deliver divine warnings. Unlike more militant angels they prefer persuasion to combat, but they fight with fierce grace when roused. Their voices cannot speak a lie."
    },
    "Solar": {
      "name": "Solar",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing",
        "magical"
      ],
      "immunities": [
        "radiant",
        "charm",
        "fear",
        "poison"
      ],
      "description": "The mightiest of angels, a towering celestial champion with multiple wings, a burning sword, and a bow that fires arrows of divine judgement. Solars are dispatched only in cosmic crises and can match demon princes and archdevils in open combat. Their wisdom is millennial, their compassion absolute, and their capacity for divine retribution terrifying. A solar rarely appears in the mortal world, and its presence means the stakes exceed comprehension."
    },
    "Unicorn": {
      "name": "Unicorn",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison",
        "charm"
      ],
      "description": "A majestic celestial horse with a coat of pearlescent white, a silver mane, and a spiralling horn that shimmers with healing magic. Unicorns inhabit the deepest ancient forests, appearing only to the pure of heart and fleeing from anyone of violent or corrupt intent. Their horns can cure disease, purify poisoned water, and heal mortal wounds. Hunting a unicorn is perhaps the most sacrilegious act a mortal can commit."
    },
    "Pegasus": {
      "name": "Pegasus",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A magnificent winged horse with a coat of gleaming white and feathered wings strong enough to carry a rider into the clouds. Pegasi are intelligent celestial creatures who choose their riders carefully, bonding only with those of noble character. They dwell in high mountain meadows and are pursued relentlessly by those seeking to capture or domesticate them. A bonded pegasus is a companion for life, not a mount to be commanded."
    },
    "Griffon": {
      "name": "Griffon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A powerful beast with the body of a lion and the head, wings, and forelimbs of a great eagle. Griffons are territorial predators that nest on high cliffs, hunting horses and other large prey. They can be trained as mounts by skilled handlers starting when they are young, bonding with a single rider for life. Mature griffons bear their chosen rider with fierce loyalty into battle or across long journeys."
    },
    "Gryphon": {
      "name": "Gryphon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A noble hybrid of lion and eagle, distinguished from its lesser cousin the griffon by its greater intelligence and more cooperative nature. Gryphons have been used as heraldic symbols by noble houses for millennia, prized for their nobility and fierce loyalty. They form life-long bonds with their chosen rider and their feathers are considered sacred charms. A gryphon will fly to avenge a fallen rider across continents if necessary."
    },
    "Hippogriff": {
      "name": "Hippogriff",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A hybrid creature with the head and wings of an eagle and the body of a horse, common in temperate hill and mountain regions. Hippogriffs are less intelligent than griffons but easier to train as mounts, making them popular among cavalry scouts and border riders. They feed on small game and grass in equal measure, reflecting their dual nature. They are skittish around fire but fierce when cornered."
    },
    "Manticore": {
      "name": "Manticore",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A monstrous creature with the body of a lion, the wings of a great bat, and the face of a cruelly intelligent humanoid. Manticores are notorious for the spikes in their tail, which they can launch like crossbow bolts at surprising range. They delight in toying with prey, often speaking in a mocking human voice before striking. They are intelligent enough to negotiate for food, but almost never honour such deals."
    },
    "Chimera": {
      "name": "Chimera",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A monstrous creation with three heads — a lion, a goat, and a dragon — atop the body of a lion with goat forequarters and great scaled wings. Chimeras attack with all three heads simultaneously, biting, butting, and breathing fire from the dragon's maw. They are thoroughly wicked and selfish, dominating lesser creatures in their mountain lairs. They are often created by aberrant wizards as guardian beasts."
    },
    "Owlbear": {
      "name": "Owlbear",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A massive forest predator with the powerful body of a bear and the head of a great owl, its bear-claws oversized and its beak capable of snapping bones. Owlbears are notoriously aggressive, attacking anything that enters their territory without provocation. Their origin is debated by sages — some say they are the creation of a mad wizard, others that they evolved naturally. They mate for life and defend their dens with terrifying ferocity."
    },
    "Basilisk": {
      "name": "Basilisk",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison"
      ],
      "description": "A heavy-bodied, eight-legged reptile the size of a large dog with dusty brown scales and eyes that glimmer with deathly green light. Basilisks can turn living creatures to stone with a direct gaze, though the transformation is slow enough that fast-moving prey can sometimes flee. They are solitary ambush predators, hiding in rocky caverns surrounded by the petrified forms of previous victims. Their blood has alchemical uses in creating potions of both stone-skin and stone-restoration."
    },
    "Cockatrice": {
      "name": "Cockatrice",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A small grotesque creature resembling a rooster crossed with a dragon, with scaly lizard-tail and dusty feathers that hide its reptilian body. Cockatrices petrify creatures they bite with a slow-acting magical toxin, an ability that makes these otherwise weak creatures a genuine threat. They are cowardly and flee larger foes, attacking only when they can ambush unguarded livestock. Their eggs are incubated by snakes rather than hens."
    },
    "Medusa": {
      "name": "Medusa",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A cursed humanoid with serpents writhing where hair should be and eyes that petrify any mortal who meets her gaze directly. Medusae were once beautiful priestesses cursed for vanity or blasphemy, and they retain both their original sorrow and their newfound rage. They dwell in ruined temples and forgotten tombs, surrounded by their stone-victims arranged as grim galleries. Some seek redemption through monastic seclusion; others embrace their curse and rule small cults of the petrified."
    },
    "Gorgon": {
      "name": "Gorgon",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison"
      ],
      "description": "A massive iron-scaled bull with glowing eyes and the ability to breathe out clouds of petrifying gas. Gorgons are often confused with medusae in common speech but are entirely distinct — they are beasts, not humanoids. They are found in wild hills, where they charge with devastating force before releasing their breath to finish fleeing prey. Their scales are prized by smiths for forging into weapons of unusual durability."
    },
    "Hydra": {
      "name": "Hydra",
      "vulnerabilities": [
        "fire"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A massive serpentine beast with five to seven snake-like heads on long muscular necks atop a dragon-like body. Hydras grow additional heads when existing heads are severed unless the stumps are cauterised with fire. They are cunning but not truly intelligent, driven by hunger and territorial aggression. A single hydra can dominate an entire swamp, picking off boats and travellers for generations."
    },
    "Werewolf": {
      "name": "Werewolf",
      "vulnerabilities": [
        "silver"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "A cursed humanoid who transforms under the full moon into a monstrous hybrid of human and wolf, towering over a normal man with rending claws and savage teeth. Werewolves retain fragments of their mortal mind in their beast-form, but the bloodlust dominates completely. Those bitten and surviving contract the curse themselves, passing the lycanthropy to new victims. Only silver weapons or blessed magic can truly harm them in beast form."
    },
    "Werebear": {
      "name": "Werebear",
      "vulnerabilities": [
        "silver"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "A lycanthrope who transforms into a massive humanoid bear, often retaining more of their mortal mind than other were-creatures. Werebears are typically benevolent, choosing their curse intentionally or embracing it after accidental infection. They often serve as guardians of isolated settlements or wild places, keeping their condition a carefully guarded secret. Their rage, when unleashed, is devastating even by lycanthrope standards."
    },
    "Wererat": {
      "name": "Wererat",
      "vulnerabilities": [
        "silver"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "A lycanthrope who transforms into a twitching, hunched rat-hybrid with reddish fur and black glinting eyes. Wererats are almost always evil-aligned, forming thieves' guilds, smuggling rings, and urban crime families in major cities. They spread their curse deliberately, adopting victims into organised criminal cults. They prefer the shadows of sewers and back alleys, emerging only to feed or conduct business."
    },
    "Elemental Air": {
      "name": "Elemental Air",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "poison"
      ],
      "description": "A living vortex of churning wind and condensed air, shaped into a vaguely humanoid spiral of currents. Air elementals can fly effortlessly, pass through narrow gaps, and whirl into a devastating cyclone that lifts and batters enemies. They are unpredictable and alien, more like weather patterns than creatures. They serve mortal summoners only reluctantly and return to the Plane of Air the moment binding magic fails."
    },
    "Elemental Earth": {
      "name": "Elemental Earth",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "poison"
      ],
      "description": "A lumbering humanoid of animated stone and soil, heavy-limbed and slow but tremendously powerful. Earth elementals can burrow through any terrain as though swimming through water, emerging beneath enemies for devastating ambush. They are stoic and deliberate, communicating in slow rumbles and ignoring most distractions. Their punches carry the weight of avalanches."
    },
    "Elemental Fire": {
      "name": "Elemental Fire",
      "vulnerabilities": [
        "cold",
        "water"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "fire",
        "poison"
      ],
      "description": "A towering pillar of living flame shaped loosely into a humanoid silhouette, crackling and roaring with hunger for fuel. Fire elementals ignite anything flammable they touch and spread destruction simply by existing, their presence in mortal settings catastrophic. They are temperamental and hostile even to their summoners, barely restrained by binding magic. Water harms them as surely as blades harm flesh."
    },
    "Elemental Water": {
      "name": "Elemental Water",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing",
        "fire"
      ],
      "immunities": [
        "poison"
      ],
      "description": "A fluid humanoid of animated water, rippling and shifting like a wave given form. Water elementals can engulf creatures to drown them, crash through small structures as breaking waves, and flow through the tiniest gaps. They are the calmest of the elementals, patient and persistent rather than chaotic. They are most dangerous near open bodies of water that feed their form."
    },
    "Black Pudding": {
      "name": "Black Pudding",
      "vulnerabilities": [
        "fire"
      ],
      "resistances": [],
      "immunities": [
        "acid",
        "cold",
        "lightning",
        "poison"
      ],
      "description": "A massive amorphous ooze of thick black acidic slime that corrodes metal, wood, and flesh on contact. Black puddings split into smaller puddings when struck with slashing or lightning damage, making crowd-control weapons almost useless against them. They are drawn to metal and consume weapons, armour, and coins with particular enthusiasm. A dungeon infested with a black pudding eventually becomes a graveyard of dissolved adventurers."
    },
    "Rust Monster": {
      "name": "Rust Monster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A strange armoured creature resembling a cross between an armadillo and a cricket, with two long feathered antennae that instantly rust any metal they touch. Rust monsters are not aggressive to living flesh, but they will eagerly consume armour, weapons, and iron implements while their owners scream in protest. They view metal as their exclusive food source and will pursue a heavily-armed party with single-minded determination. Adventurers often flee them despite their harmlessness to living creatures."
    },
    "Mimic": {
      "name": "Mimic",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "acid"
      ],
      "description": "A shape-shifting aberration that takes the form of common objects — treasure chests being the notorious favourite — waiting motionless for curious creatures to investigate. Mimics lunge with adhesive pseudopods when a victim draws close, clamping down with surprising strength. Despite their hunger they are intelligent enough to negotiate, and some have been known to cooperate with thieves' guilds as living traps. Their digestion is slow, so victims sometimes remain alive and aware within their forms for days."
    },
    "Doppelganger": {
      "name": "Doppelganger",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "charm"
      ],
      "description": "A shape-shifting humanoid with pale grey skin, slit pupils, and elongated fingers in its natural form. Doppelgangers can assume the form of any humanoid they have observed, copying not just appearance but voice, mannerisms, and partial memory by reading minds through contact. They infiltrate families, governments, and organisations, replacing individuals for years or even decades. They are cunning and patient, viewing mortal lives as costumes to wear."
    },
    "Gargoyle": {
      "name": "Gargoyle",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "poison"
      ],
      "description": "A winged humanoid statue of dark stone that perches motionless on rooftops and cornices until movement catches its carved eyes. Gargoyles pass for architectural decoration perfectly until they launch themselves from their perch, and are often deliberately placed by dark wizards as living guardians. They are slow but tireless, and their stone hides shrug off most weapons. They often decorate the castles of liches and necromancers where they serve as silent sentries."
    },
    "Gelugon Ice Devil": {
      "name": "Gelugon Ice Devil",
      "vulnerabilities": [
        "radiant",
        "fire"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "cold",
        "fire",
        "poison"
      ],
      "description": "A towering insectoid devil of pale icy blue chitin, mandibles dripping frost and tail ending in a wicked barbed stinger. Ice devils serve as officers and task-masters in the hierarchy of hell, enforcing infernal law with cold precision and unshakable discipline. They carry barbed polearms of living ice that freeze flesh on contact. Their calm in battle is utterly unsettling — they show no emotion, only mechanical efficiency."
    },
    "Erinyes": {
      "name": "Erinyes",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "fire",
        "poison"
      ],
      "description": "A winged female devil of cruel beauty wielding a longsword and longbow drawn from living infernal fire. Erinyes are the huntresses of hell, pursuing specific souls through the mortal world on contracts bound by infernal law. They are relentless, intelligent, and occasionally capable of conflicted mercy toward those who remind them of the angels they once were. Their arrows never miss their bound target."
    },
    "Marilith": {
      "name": "Marilith",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "fire",
        "lightning"
      ],
      "immunities": [
        "poison"
      ],
      "description": "A six-armed demon with the upper body of a beautiful woman and the lower body of a massive serpent, each hand wielding a different sword. Mariliths are demon generals, masters of tactical warfare who command vast demonic hosts against celestial legions. Their six-blade dance can shred a seasoned warrior in seconds, each sword moving in perfectly independent combat sequences. They relish both warfare and the subtle games of court politics."
    },
    "Hezrou": {
      "name": "Hezrou",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "fire",
        "lightning"
      ],
      "immunities": [
        "poison"
      ],
      "description": "A massive toad-like demon with warty blue-black hide, long claws, and a stench so foul it nauseates creatures within several paces. Hezrou are the infantry of the Abyss, tough enough to soak terrible punishment while dealing it back with their massive fists. They are dim-witted even by demon standards but deeply malicious, enjoying the terror they inspire as much as the harm they cause. Their reek alone can send hardened warriors retching."
    },
    "Dretch": {
      "name": "Dretch",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "fire",
        "lightning"
      ],
      "immunities": [
        "poison"
      ],
      "description": "A small, pathetic demon with sickly grey skin, a wide sulking mouth, and a cowardly disposition. Dretches are formed from the most miserable damned souls and serve as cannon-fodder in demonic armies. Individually they are barely a threat, but they attack in swarms and can release a paralytic gas from their bodies that stuns nearby creatures. Demon lords barely acknowledge their existence beyond their utility as expendable numbers."
    },
    "Quasit": {
      "name": "Quasit",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "fire",
        "lightning",
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "poison"
      ],
      "description": "A tiny demon with rust-red skin, small bat wings, and a long barbed tail, serving as the demonic counterpart to a devil's imp. Quasits serve as familiars to evil spellcasters and masters of corruption, spying on targets and whispering malice into vulnerable ears. They can turn invisible and shapeshift into small animals, ideal for infiltration. Their bargains corrupt more subtly than devils' — they don't write contracts, they just gradually make evil seem normal."
    },
    "Yuan-Ti Pureblood": {
      "name": "Yuan-Ti Pureblood",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison"
      ],
      "description": "A serpent-descended humanoid who can pass for human with only subtle serpentine features — slit pupils, occasional forked tongue, faint scaling on the back. Purebloods are the diplomats and infiltrators of yuan-ti society, living in mortal cities while serving the snake-temples hidden in jungle ruins. They are cunning, amoral, and supremely confident in the inevitability of their race's return to dominance. Many hold positions of significant political power without their nature being suspected."
    },
    "Yuan-Ti Malison": {
      "name": "Yuan-Ti Malison",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison"
      ],
      "description": "A yuan-ti with mixed human and serpent traits — a snake's head, or a snake tail in place of legs, or venomous fangs and mottled scales. Malisons serve as warriors and priests in yuan-ti society, physically stronger than purebloods and more openly bestial. They wield curved swords and spellcraft taught by their serpent gods. Their disdain for non-yuan-ti is absolute."
    },
    "Yuan-Ti Abomination": {
      "name": "Yuan-Ti Abomination",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison"
      ],
      "description": "The most powerful of yuan-ti, a massive serpent-headed humanoid or sometimes simply a huge cobra with arms. Abominations are priest-kings and high generals of their race, wielding potent constriction and venom alongside dark magic learned from serpent gods. They view their pureblood and malison kin as necessary servants and everyone else as food or labour. A temple served by an abomination becomes a factory of subtle corruption for a hundred miles around."
    },
    "Drow Elite Warrior": {
      "name": "Drow Elite Warrior",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A dark-elf warrior in black chainmail etched with spider-motifs, wielding twin scimitars with graceful lethality. Drow elite warriors are products of a brutal underground society where weakness is culled and strength through treachery is celebrated. They fight with calculating precision, using formation tactics refined over centuries of underworld warfare. They view all surface-dwellers as lesser life forms, barely worth the effort of killing."
    },
    "Drow Priestess": {
      "name": "Drow Priestess",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A drow woman in flowing black robes adorned with jet-and-silver spider fetishes, channelling the malevolent blessings of her demon-spider goddess. Priestesses rule drow society absolutely, commanding the elite warriors and political structure through the authority of their dark patron. Their whip is said to hold the souls of previous failed enemies, each snake-strand alive with hungry venom. They are the most dangerous figures in any drow household, deadly and politically merciless."
    },
    "Duergar": {
      "name": "Duergar",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [
        "poison",
        "charm"
      ],
      "description": "A grey-skinned dwarf of the deep underdark with a bald head, thin tangled beard, and perpetually grim expression. Duergar live in vast underground forge-cities ruled by slavery and cruel hierarchy, consumed by bitter resentment toward their surface kin. They can grow to twice their height through ancient psionic training and turn invisible at will. They despise joy, beauty, and all softer emotions as surface-dwelling weaknesses."
    },
    "Deep Gnome": {
      "name": "Deep Gnome",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A small, grey-skinned gnome (called svirfneblin) who dwells in the upper Underdark, mining precious gems and avoiding the attention of the darker races below. Deep gnomes are skittish, reclusive, and fiercely protective of their hidden communities. They possess natural illusion magic and the ability to blend into stone walls, making them nearly impossible to track. They trade cautiously with surface dwarves but never reveal the location of their settlements."
    },
    "Grimlock": {
      "name": "Grimlock",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A pale, eyeless humanoid with wiry muscle and keen hearing and smell that compensate for total blindness. Grimlocks are descendants of humans who were enslaved by mind flayers and aboleths generations ago, now thoroughly adapted to lightless underground life. They hunt in silent packs through tunnels, often serving mind flayers or more powerful underdark creatures as shock troops. They perceive sighted creatures as having a bizarre vulnerability."
    },
    "Troglodyte": {
      "name": "Troglodyte",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A reptilian humanoid with grey-scaled skin, stubby claws, and an absolutely foul stench that nauseates anyone near it. Troglodytes dwell in caves and ruins, hunting in packs through warrens they have fouled beyond endurance. They can shift their scale-colouration for limited camouflage and strike with surprising speed. They are intellectually primitive but deeply hostile to all other races."
    },
    "Sahuagin": {
      "name": "Sahuagin",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A fish-humanoid with green-black scales, webbed hands, sharp teeth, and the occasional mutant four-armed specimen born as a potential priestess. Sahuagin are the sharks of humanoid races, raiding coastal settlements from undersea cities governed by rigid warrior codes. They are driven into feeding frenzy by the scent of blood, even allies' blood. They worship a shark-god with bloody rituals."
    },
    "Merfolk": {
      "name": "Merfolk",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An aquatic humanoid with a humanoid upper body and a scaled fish tail, dwelling in the shallows and reef-cities of coastal waters. Merfolk are generally peaceful and curious about the surface world, sometimes trading with coastal villages through carefully negotiated exchanges. Their societies are matriarchal and built around sacred reefs passed down through generations. They war often with sahuagin and maintain careful peace with sea-dwelling dragons."
    },
    "Triton": {
      "name": "Triton",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A proud aquatic humanoid with pale blue-green skin, silver hair, and the bearing of a patrician noble. Tritons guard the depths of the ocean from sahuagin, krakens, and the eldritch horrors of the deeper trenches, viewing themselves as hereditary protectors of the seas. They possess innate magic and speak with sea creatures. Their arrogance toward surface-dwellers can be grating, but their loyalty to those who earn it is absolute."
    },
    "Sphinx": {
      "name": "Sphinx",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "psychic",
        "charm",
        "fear"
      ],
      "description": "A massive creature with the body of a lion, the wings of an eagle, and the head of a wise humanoid, guardian of ancient tombs and cosmic knowledge. Sphinxes are timeless beings who exist to guard specific places or secrets for eons, testing those who approach with elaborate riddles. A correctly answered riddle grants passage or treasure; a wrong answer often ends in consumption. They are ancient and alien, viewing mortal lives as brief curiosities."
    },
    "Kraken": {
      "name": "Kraken",
      "vulnerabilities": [],
      "resistances": [
        "fire"
      ],
      "immunities": [
        "lightning",
        "cold"
      ],
      "description": "A colossal tentacled monstrosity the size of a ship, dwelling in the deepest ocean trenches and dragging entire vessels to the abyss. Krakens are intelligent and ancient, cultivating cults of merfolk and surface-dwelling worshippers who bring them sacrifices. A kraken's tentacles can crush warships, and its lightning breath can scorch entire fleets. They view the surface world as alien territory they occasionally harvest."
    },
    "Roc": {
      "name": "Roc",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An enormous eagle-like bird of prey the size of a small castle, capable of carrying off elephants and orcas in its talons. Rocs nest on the peaks of the highest mountains, hunting across continents for their monstrous prey. They are animals rather than intelligent creatures, but animals of such scale that their attention is invariably catastrophic. A single roc can depopulate a region's livestock for a generation."
    },
    "Purple Worm": {
      "name": "Purple Worm",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A massive subterranean worm the size of a dragon, with dark purple chitinous armour, enormous grinding teeth, and a venomous barbed tail. Purple worms tunnel through solid rock as though it were soil, emerging to swallow entire parties of adventurers whole. They are not intelligent, but their scale and indestructibility make them nightmare threats in Underdark delves. Tunnels left by purple worms have been used as infrastructure by entire dwarven kingdoms."
    },
    "Displacer Beast": {
      "name": "Displacer Beast",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A predatory cat the size of a lion with two long, spike-tipped tentacles growing from its shoulders and the supernatural ability to appear slightly offset from its actual position. Displacer beasts are brutally intelligent, stalking prey with cruel patience before their tentacle-strikes shatter bone. They are prized by drow as hunting animals, though they resist all but the most ruthless training. Their displacement makes them nightmarishly difficult to strike accurately."
    },
    "Intellect Devourer": {
      "name": "Intellect Devourer",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison",
        "charm"
      ],
      "description": "A disturbing aberration resembling a naked human brain mounted on four clawed animal legs, scuttling through mind flayer cities and deep dungeons. Intellect devourers attack by leaping at humanoid heads, consuming the victim's brain and taking control of the hollow body for its master. The host corpse shambles convincingly enough to pass as living for short periods, making intellect devourers useful infiltrators. Killing the body does not destroy the brain-creature riding within."
    },
    "Gibbering Mouther": {
      "name": "Gibbering Mouther",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A writhing mass of eyes, mouths, and rippling flesh that absorbs its victims into its own grotesque body. Gibbering mouthers pour out constant streams of babbling nonsense from their many mouths, a sound that can confuse and madden those who hear it. They flow across terrain like thick slurry, engulfing anything too slow to flee. They are believed to be the result of failed transmutation experiments, though some sages argue they come naturally from certain chaos-touched regions."
    },
    "Rakshasa": {
      "name": "Rakshasa",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing",
        "fire"
      ],
      "immunities": [],
      "description": "An immortal fiend in the form of a humanoid tiger or other bestial aristocrat, often wearing elaborate court clothing with hands whose palms face backward. Rakshasas dwell in mortal society as nobles, merchant princes, and advisors, cultivating power and corrupting kingdoms over centuries. Killing one only sends it back to its home plane where it slowly reforms, returning to finish what was started. They are master illusionists and charmers with millennia of manipulative experience."
    },
    "Night Hag": {
      "name": "Night Hag",
      "vulnerabilities": [],
      "resistances": [
        "cold",
        "fire"
      ],
      "immunities": [
        "charm"
      ],
      "description": "A dread fey creature that invades the dreams of mortals, corrupting them toward evil over many nights of torment. Night hags can walk through the borders of sleep physically, appearing in dreams as hideous crones offering twisted bargains. They collect the souls of mortals they corrupt successfully, turning those souls into dark gems used for infernal commerce. They are old beyond counting and utterly without mercy."
    },
    "Revenant": {
      "name": "Revenant",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "necrotic",
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "poison",
        "charm",
        "fear"
      ],
      "description": "The reanimated corpse of a mortal who died with an all-consuming purpose of vengeance, rising from the grave to pursue their murderer across any distance. Revenants have one year to fulfil their purpose before their soul is lost to the abyss, and during that year they cannot be permanently killed — destroyed bodies reform within days. They are single-minded and terrifying, driven by cold, focused hatred rather than mindless undead hunger. They often ignore all obstacles to reach their target."
    },
    "Death Knight": {
      "name": "Death Knight",
      "vulnerabilities": [],
      "resistances": [
        "necrotic",
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "poison",
        "charm",
        "fear"
      ],
      "description": "A fallen paladin raised as undead, eternally bound to his blackened armour and the cursed blade that drank his oath. Death knights retain their martial skill and knowledge of divine magic perverted toward darkness, wielding unradiant auras that wither the very ground they tread. They are tragic figures as much as evil ones, aware of what they have lost but unable to reclaim it. Some seek redemption; most embrace their damnation with bitter pride."
    },
    "Beholder Death Tyrant": {
      "name": "Beholder Death Tyrant",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison",
        "charm",
        "fear"
      ],
      "description": "An undead beholder whose flesh has decayed to reveal the skull beneath its massive central eye, its eyestalks dangling with tattered sinew. Death tyrants retain all their intelligence and eye-ray powers, but with necromantic magic replacing their former abilities. Their central eye now emits a life-draining gaze rather than antimagic. They often lead armies of lesser undead, ruling small kingdoms of corpse-thralls from their lairs."
    },
    "Lich Archmage": {
      "name": "Lich Archmage",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "magical",
        "cold",
        "lightning"
      ],
      "immunities": [
        "necrotic",
        "poison",
        "disease",
        "fear",
        "charm"
      ],
      "description": "A lich of millennial age whose spellcraft has advanced to near-godlike levels, warping reality within their lair through sheer magical accumulation. Lich archmages are often former apprentices of deities themselves, now pursuing research on questions no living mind could endure. They command vast undead armies and hoards of magical knowledge that would require centuries to catalogue. Their phylacteries are often hidden across entire continents, requiring quests to find each before the lich can be destroyed. Lich Archmages should receive a wide variety of spells ranging from first to ninth level. Primarily necromancy but also other magic schools"
    },
    "Archdevil": {
      "name": "Archdevil",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "piercing",
        "bludgeoning",
        "slashing",
        "magical"
      ],
      "immunities": [
        "fire",
        "poison",
        "charm",
        "fear"
      ],
      "description": "One of the ruling lords of the Nine Hells, each a being of primordial evil commanding entire infernal layers and armies of devils beyond counting. Archdevils rarely manifest physically in the mortal realm, their attention usually deployed through carefully selected lieutenants. When one does appear, entire kingdoms tremble. They bargain only with souls of exceptional value, and their contracts have loopholes even the clever cannot escape."
    },
    "Demon Lord": {
      "name": "Demon Lord",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "cold",
        "fire",
        "lightning"
      ],
      "immunities": [
        "poison"
      ],
      "description": "One of the rare rulers of the infinite Abyss, each a singular force of chaotic evil, embodied as a unique monster of legendary power. Demon lords include the slaughter-hound Yeenoghu, the spider queen Lolth, the hag-prince Malcanthet, and dozens more, each a walking catastrophe. Their manifestations in the mortal realm are civilisation-ending events, usually held back only by active divine intervention. They cannot be truly killed, only banished, returning in time to rebuild their cults."
    },
    "Bandit": {
      "name": "Bandit",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An ordinary criminal in worn leather armour, armed with a simple sword or crossbow, who turned to roadside robbery out of desperation or greed. Bandits are not professional soldiers but they know their trade — ambush spots, target selection, and knowing when to cut losses and flee. They operate in small groups under loose hierarchy, loyal only as long as the loot is flowing. Most would prefer intimidation to actual killing."
    },
    "Knight": {
      "name": "Knight",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A professional warrior in heavy plate armour bearing the heraldic arms of a noble house or chivalric order. Knights are expertly trained in mounted combat, weapon-fighting, and the formal codes of chivalry that distinguish them from common mercenaries. They are often idealistic about their oaths though the realities of their liege lords may strain those ideals. A knight's word is their bond, and breaking it invites social ruin."
    },
    "Veteran": {
      "name": "Veteran",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A seasoned soldier who has fought in multiple wars and emerged with hard-won experience and visible scars. Veterans wear mismatched armour scavenged across campaigns, wielding a weapon they know intimately from years of use. They are pragmatic killers without the idealism of young knights or the corruption of career mercenaries. They often train the next generation of soldiers, or hire out their skills to the highest bidder."
    },
    "Assassin": {
      "name": "Assassin",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A professional killer cloaked in dark leather, face masked or shadowed, carrying poisoned blades and the tools of infiltration. Assassins move through cities unnoticed, their contracts always completed, their employers usually never meeting them face to face. They are cold and methodical, viewing targets as work to be completed rather than enemies to be hated. Their guilds maintain rigid discipline and punish failure with death."
    },
    "Spy": {
      "name": "Spy",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An agent of intelligence or counter-intelligence, trained in observation, disguise, manipulation, and the subtle tradecraft of information gathering. Spies blend into crowds, households, and organisations, passing messages through dead drops and coded correspondence. They are rarely killers by preference but will defend themselves with practiced violence when compromised. Their loyalty is to the service, the coin, or the cause — rarely to any individual."
    },
    "Cult Fanatic": {
      "name": "Cult Fanatic",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A robed zealot completely consumed by devotion to a dark god, demon lord, or forbidden doctrine, wielding corrupted divine magic alongside ritual daggers. Cult fanatics lead smaller cells of cultists through inspiring sermons and dark rituals, their eyes burning with the certainty of true believers. They welcome death in service to their cause, seeing it as the gateway to eternal reward. Their willingness to die makes them surprisingly dangerous in open confrontation."
    },
    "Cultist": {
      "name": "Cultist",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An ordinary person caught up in a dark religion, wearing ritual robes over their regular clothing and carrying a simple weapon to defend their beliefs. Cultists range from true believers to coerced victims to opportunists seeking power, united only by their participation in forbidden rites. They are not skilled warriors but their numbers and ritual-empowered confidence make them dangerous in mass. They often serve as expendable soldiers for more powerful figures in their organisation."
    },
    "1st-level Spellcaster": {
      "name": "1st-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A highly novice spellcaster, still under a tutor's eye. First level mages should only have three or four spells, three of which being cantrips and one of which being a 1st-level spell. Their magic falters under pressure."
    },
    "2nd-level Spellcaster": {
      "name": "2nd-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster past their first formal trials. Second level mages should have three cantrips and two 1st-level spells. They tire quickly in extended combat."
    },
    "3rd-level Spellcaster": {
      "name": "3rd-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster who has completed their first cycle of study. Third level mages should have three cantrips and three 1st-level spells, often including a defensive option such as shield or mage armour."
    },
    "4th-level Spellcaster": {
      "name": "4th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A competent spellcaster permitted to travel and work outside their tutor's oversight. Fourth level mages should have four cantrips, three 1st-level spells, and one 2nd-level spell."
    },
    "5th-level Spellcaster": {
      "name": "5th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A capable spellcaster nearing the threshold of true power. Fifth level mages should have four cantrips, three 1st-level spells, two 2nd-level spells, and one 3rd-level spell, marking their first access to battlefield-altering magic such as fireball or counterspell."
    },
    "6th-level Spellcaster": {
      "name": "6th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A reliable spellcaster comfortable in field conditions. Sixth level mages should have four cantrips, three 1st-level spells, two 2nd-level spells, and two 3rd-level spells. They often serve as house wizards or military attachés."
    },
    "7th-level Spellcaster": {
      "name": "7th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster of established reputation. Seventh level mages should have four cantrips, three 1st-level spells, two 2nd-level spells, two 3rd-level spells, and one 4th-level spell. They have learned to maintain a permanent ward that compensates for their physical fragility."
    },
    "8th-level Spellcaster": {
      "name": "8th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster hardened by combat or competition. Eighth level mages should have four cantrips, three 1st-level spells, two 2nd-level spells, two 3rd-level spells, and two 4th-level spells."
    },
    "9th-level Spellcaster": {
      "name": "9th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster of significant standing within their order. Ninth level mages should have four cantrips, three 1st-level spells, two 2nd-level spells, two 3rd-level spells, two 4th-level spells, and one 5th-level spell."
    },
    "10th-level Spellcaster": {
      "name": "10th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A respected spellcaster often given charge of apprentices. Tenth level mages should have five cantrips, three 1st-level spells, two each of 2nd through 4th level spells, and two 5th-level spells."
    },
    "11th-level Spellcaster": {
      "name": "11th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster who has crossed into the upper tier of arcane practice. Eleventh level mages should have five cantrips, three 1st-level spells, two each of 2nd through 5th level spells, and one 6th-level spell. Their signature spell is often a hallmark of identification."
    },
    "12th-level Spellcaster": {
      "name": "12th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster of decades' practice, frequently consulted on matters of arcane theory. Twelfth level mages should have five cantrips, three 1st-level spells, and two each of 2nd through 6th level spells."
    },
    "13th-level Spellcaster": {
      "name": "13th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A formally titled master of magic, often holding office within an academy or tower. Thirteenth level mages should have five cantrips, three 1st-level spells, two each of 2nd through 6th level spells, and one 7th-level spell. Permanent stoneskin or equivalent is typical."
    },
    "14th-level Spellcaster": {
      "name": "14th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A scholar-mage whose breadth of knowledge rivals their power. Fourteenth level mages should have five cantrips, three 1st-level spells, two each of 2nd through 6th level spells, and two 7th-level spells. They often possess obscure ritual magics not commonly taught."
    },
    "15th-level Spellcaster": {
      "name": "15th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster recognised across kingdoms. Fifteenth level mages should have five cantrips, three 1st-level spells, two each of 2nd through 7th level spells, and one 8th-level spell."
    },
    "16th-level Spellcaster": {
      "name": "16th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster of legendary regional importance. Sixteenth level mages should have five cantrips, three 1st-level spells, two each of 2nd through 7th level spells, and two 8th-level spells. They almost always have a signature contingency or active protection."
    },
    "17th-level Spellcaster": {
      "name": "17th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster whose name is known across continents. Seventeenth level mages should have five cantrips, three 1st-level spells, two each of 2nd through 8th level spells, and one 9th-level spell."
    },
    "18th-level Spellcaster": {
      "name": "18th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster operating at the apex of mortal practice. Eighteenth level mages should have five cantrips, four 1st-level spells, three each of 2nd through 5th level spells, two each of 6th through 8th, and one 9th-level spell. They are wreathed in lasting wards that resist most magical assault."
    },
    "19th-level Spellcaster": {
      "name": "19th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster whose work reshapes the field of magic itself. Nineteenth level mages should have five cantrips, four 1st-level spells, three each of 2nd through 5th level spells, two each of 6th through 8th, and two 9th-level spells."
    },
    "20th-level Spellcaster": {
      "name": "20th-level Spellcaster",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A spellcaster at the peak of arcane achievement, rivalled only by gods, dragons, and other archmages. Twentieth level mages should have five or more cantrips, multiple spells of every level up to 9th, with three or more 9th-level spells. They typically possess one or more signature abilities representing decades of original research."
    },
    "Priest": {
      "name": "Priest",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A devoted servant of a deity, wearing vestments of their god's colours and carrying a radiant symbol prominently. Priests are trained in divine magic, ceremony, and theology, serving as spiritual leaders of villages, temples, or traveling missions. They are healers, counsellors, and occasional warriors in their god's cause, their competence varying with their calling. Even rank-and-file priests can be dangerous when their faith gives them conviction."
    },
    "Druid": {
      "name": "Druid",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A nature-attuned spellcaster in leather or hide armour, carrying a wooden staff adorned with charms of bone, feather, and polished stone. Druids commune with the spirits of wild places, drawing on primal magic to call lightning, summon beasts, and transform into animal forms themselves. They are protectors of wilderness against those who would tame or exploit it. Their hostility to cities and civilisation varies enormously between individuals and circles."
    },
    "Scout": {
      "name": "Scout",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A woodland tracker in mottled leather, skilled with bow, trap, and knife, who knows the local terrain better than any map. Scouts work for armies, nobles, and villages, providing reconnaissance and early warning of threats. They are self-reliant loners more comfortable in forest than city, with a deep practical knowledge of edible plants, dangerous animals, and the subtle signs of passage. Their hand-to-hand skills are solid if unremarkable — they prefer to avoid combat where possible."
    },
    "Noble": {
      "name": "Noble",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A member of the aristocracy wearing fine clothing, bejewelled with family heirlooms, and carrying a ceremonial weapon that may or may not be ornamental. Nobles range from genuine leaders of their houses to decadent hangers-on consumed by court intrigue. Their education includes etiquette, history, rhetoric, and usually at least passing familiarity with the sword. They expect deference from commoners and negotiate from positions of assumed superiority."
    },
    "Guard": {
      "name": "Guard",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A uniformed watchman in chain or leather armour, carrying a spear or sword and the authority of the city or noble they serve. Guards patrol streets, walls, and gates, maintaining order and responding to disturbances with varying degrees of competence and enthusiasm. They range from earnest idealists to corrupt bribe-takers depending on the institution. They are the first line of defence against small threats and the first to die against serious ones."
    },
    "Commoner": {
      "name": "Commoner",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "An ordinary citizen in plain homespun clothing, going about their daily work as farmer, labourer, shopkeeper, or household servant. Commoners have no training in combat or magic, and are the overwhelming majority of any population. They are resourceful within their own spheres but terrified and helpless when unusual threats emerge. They represent the people that adventurers are usually meant to protect."
    },
    "Merchant": {
      "name": "Merchant",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A trader in decent clothes that hint at prosperity without flaunting wealth, carrying ledgers and coin pouches and accompanied by guards for valuable journeys. Merchants vary from travelling peddlers to wealthy magnates, but all share an eye for profit, a gift for negotiation, and a network of contacts across multiple towns or regions. They are rarely combatants themselves but know exactly who to hire when protection is needed. Information is currency to them, traded carefully and priced accordingly."
    },
    "Innkeeper": {
      "name": "Innkeeper",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "The proprietor of a tavern or inn, competent with a cudgel kept behind the bar and familiar with every regular's name and preferred drink. Innkeepers see everything that passes through their establishment and hear most of the local gossip, making them invaluable sources of information for adventurers. They maintain careful neutrality in most conflicts, valuing their customers over any single alliance. Their hospitality is warm but calculated."
    },
    "Blacksmith": {
      "name": "Blacksmith",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A broad-shouldered smith with soot-stained leather apron and arms thickly muscled from years at the forge, wielding hammer and tongs with casual expertise. Blacksmiths craft and repair weapons, armour, tools, and nails for their communities, their shops the loud heart of any town. They are physically formidable even when unarmed, and many take up hammer and tongs in defence of their forge. Their knowledge of metalwork makes them occasional allies in identifying and repairing unusual weapons."
    },
    "Sage": {
      "name": "Sage",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A scholar surrounded by books, scrolls, and carefully catalogued artifacts, dedicated to research in a specific field of knowledge. Sages specialise — one may know every dragon species, another the history of fallen empires, another the taxonomy of Underdark fauna. They rarely engage with the outside world directly but their expertise is invaluable to adventurers seeking to understand what they face. They trade knowledge for gold or interesting new specimens and stories."
    },
    "Hermit": {
      "name": "Hermit",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A solitary figure in simple robes living in a hut or cave far from civilisation, their beard and hair untrimmed, their eyes bright with accumulated quiet wisdom. Hermits pursue isolation for religious, philosophical, or personal reasons, often developing unusual insights from years of undistracted contemplation. They may be kindly sages willing to share their knowledge, or cranky recluses who view visitors as intrusions. Many know secrets the wider world has long forgotten."
    },
    "Thief": {
      "name": "Thief",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A light-footed criminal in dark practical clothing, carrying lockpicks, a shortsword, and a thorough familiarity with the rooftops and alleys of their chosen city. Thieves range from desperate orphans picking pockets to members of organised guilds running elaborate schemes. They live by their wits and reflexes, preferring stealth and escape to direct confrontation. Their networks of fences and contacts span the urban underworld."
    },
    "Pirate Captain": {
      "name": "Pirate Captain",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A flamboyant ship-master in weatherworn finery, wielding cutlass and pistol with years of brutal experience on the open seas. Pirate captains command their crews through a mixture of charisma, fear, and personal combat prowess, holding elected positions that can shift dramatically with success or failure. They are rulers of wooden kingdoms that move across the waves, answerable only to the profit of the crew. Their reputations precede them into every port."
    },
    "Gladiator": {
      "name": "Gladiator",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A professional arena-fighter in ornamental armour designed more for spectacle than practicality, carrying signature weapons that have become part of their brand. Gladiators fight for the crowd as much as for victory, performing flashy combat manoeuvres that are genuinely dangerous but also genuinely crowd-pleasing. They range from condemned slaves to voluntary celebrities, depending on the culture. Their theatrical style makes them predictable to trained soldiers but overwhelming to untrained foes."
    },
    "Berserker": {
      "name": "Berserker",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "A wild warrior who works himself into a battle-frenzy before combat, fighting without regard for his own safety. Berserkers wear minimal armour — often just leather and warpaint — and carry enormous weapons they swing in reckless arcs. Their rage makes them almost indifferent to pain, and they often continue fighting long after wounds should have felled them. They come from various barbarian cultures where such madness is considered a gift rather than a curse."
    },
    "Tribal Warrior": {
      "name": "Tribal Warrior",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A warrior from a clan-based culture, wearing leather armour adorned with tribal markings and carrying spear, javelin, or tribal sword. Tribal warriors fight for their clan and kin with fierce loyalty, their martial training rooted in generations of cultural tradition. They are resilient in wilderness conditions that would destroy more civilised troops, and their connection to ancestral spirits gives them unique strengths. They view outsiders with suspicion but strong hospitality once trust is earned."
    },
    "Dark Wizard": {
      "name": "Dark Wizard",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "magical"
      ],
      "immunities": [],
      "description": "A wizard who has turned to forbidden magical disciplines — necromancy, demonology, fleshcraft — wearing robes embroidered with runes that would horrify lawful scholars. Dark wizards pursue power through paths normal mages refuse to walk, accepting corruption as acceptable cost. They often maintain hidden towers or underground laboratories where they conduct research that would see them executed if discovered. Their magical power is real and substantial, born of willingness to do what others will not."
    },
    "Elder Brain": {
      "name": "Elder Brain",
      "vulnerabilities": [],
      "resistances": [
        "psychic"
      ],
      "immunities": [
        "charm",
        "fear"
      ],
      "description": "The pooled consciousness of dozens of mind flayers fused into a single enormous brain floating in a pool of brine, ruling an entire illithid colony as a god-mind. Elder brains command their flayer-children telepathically across vast distances, coordinating the colony's activities with alien precision. They can launch mental assaults that reach through miles of stone to strike at a target's thoughts directly. Their death collapses an entire mind-flayer city."
    },
    "Drider": {
      "name": "Drider",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A cursed drow transformed by the displeasure of their spider goddess into a horrifying half-humanoid, half-spider hybrid with a drow torso atop a massive arachnid body. Driders retain the intelligence and magical training of their previous life but are driven mad by their transformation and the knowledge that they are now exiled from drow society. They lurk in Underdark tunnels, preying on any living creature out of bitter rage. A drider's pain is constant, and they take grim satisfaction in spreading it."
    },
    "Treant": {
      "name": "Treant",
      "vulnerabilities": [
        "fire"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "A massive walking tree the size of a tower, with bark-skin, limb-branches, and eyes like hollows in an ancient oak. Treants are among the oldest creatures of the forest, some remembering millennia before the current mortal races existed. They are slow to anger and slow to act, but when provoked they can crush armoured knights beneath their feet and hurl boulders as casually as mortals throw stones. They protect the deep old-growth forests against axe, flame, and desecration."
    },
    "Ent": {
      "name": "Ent",
      "vulnerabilities": [
        "fire"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [],
      "description": "An elder tree-spirit very similar in nature to a treant, but bonded to a specific ancient grove rather than being a truly mobile entity. Ents spend centuries rooted in their grove, gathering wisdom from the slow conversation of their trees, and awaken only when serious threat or great need stirs them. They speak in a cadenced tongue of wind through leaves and deep wood, each word carrying centuries of meaning. When ents march, entire forests move."
    },
    "Elf Pureblood": {
      "name": "Elf Pureblood",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "charm"
      ],
      "description": "A tall, ethereal elf with pointed ears, almond eyes, and the grave beauty of a long-lived race. Pureblood elves are the aristocracy of elven society, raised in ancient traditions of magic, craft, and courtly etiquette that stretch back millennia. They speak in measured tones and regard mortal hurry with distant amusement. Their lifespan of centuries makes their relationships with shorter-lived races carefully calibrated — affection must be managed against the weight of inevitable loss."
    },
    "Wood Elf Ranger": {
      "name": "Wood Elf Ranger",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "charm"
      ],
      "description": "A woodland elf in earth-toned leather and forest-green cloak, carrying a longbow and moving through dense foliage with impossible silence. Wood elves live in harmony with the deep forests, their communities scattered through the canopy in ways invisible to outsiders. They are reclusive and suspicious of intruders, communicating with the animals and plants of their homeland through an almost-instinctual bond. A wood elf archer can strike accurately at distances most races cannot see."
    },
    "Dwarf Warrior": {
      "name": "Dwarf Warrior",
      "vulnerabilities": [],
      "resistances": [
        "poison"
      ],
      "immunities": [],
      "description": "A stocky, broad-shouldered dwarf in masterwork chainmail, braided beard tied with iron rings, wielding a warhammer or axe of exquisite craftsmanship. Dwarves are natural warriors whose stone-fortress cities are defended by formations of veterans, each carrying weapons forged by their own hands or those of their kin. They value craftsmanship, loyalty, and centuries-deep grudges against racial enemies. A dwarf's word is as hard as their stone, given rarely but honoured absolutely."
    },
    "Halfling Rogue": {
      "name": "Halfling Rogue",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A cheerful, three-foot-tall humanoid with nimble hands, curly hair, and bright eyes that miss nothing. Halfling rogues combine natural luck with practiced dexterity, making them some of the most competent thieves and scouts in any adventuring company. They downplay their own skill with casual modesty, often only revealing their competence when absolutely necessary. Their small size and charm make them nearly impossible to suspect until the deed is already done."
    },
    "Gnome Artificer": {
      "name": "Gnome Artificer",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A diminutive gnome in soot-stained work clothing, goggles pushed up on a balding head, workbench scattered with clockwork parts and half-finished inventions. Gnome artificers combine magical understanding with mechanical ingenuity to create devices that blend arcane and technological principles. Their workshops are fire-hazards of the finest kind, constantly in various states of controlled catastrophe. They are enthusiastic about their craft to the point of distraction, often trailing off mid-sentence to jot down an idea."
    },
    "Dragonborn Warrior": {
      "name": "Dragonborn Warrior",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A tall, imposing humanoid with draconic scales, a reptilian snout, and the proud bearing of a warrior who can trace their lineage to true dragons. Dragonborn warriors fight with a combination of weapon skill and a short breath weapon matching their heritage — fire, cold, lightning, acid, or poison. They value honour above most other concerns, often holding themselves to personal codes stricter than any law. Their clan affiliations are central to their identity."
    },
    "Tiefling Warlock": {
      "name": "Tiefling Warlock",
      "vulnerabilities": [],
      "resistances": [
        "fire"
      ],
      "immunities": [],
      "description": "A humanoid of human base with unmistakable infernal heritage — horns, reddened skin, a spaded tail, or glowing eyes — who has pacted with an otherworldly patron for magical power. Tiefling warlocks face ancestral prejudice in most human societies, which often pushes them toward solitary or criminal paths. Their magical abilities combine with natural fire resistance and occasional subtle fiendish charm. Many struggle with the assumption that their heritage defines their character, complicated by the reality that some of them find the assumption comforting."
    },
    "Half-Orc Mercenary": {
      "name": "Half-Orc Mercenary",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A tall, muscled warrior with human proportions and orcish features — green-tinged skin, prominent canines, heavy brow — carrying mismatched armour paid for in blood across many campaigns. Half-orcs face prejudice from both parent races, which often drives them toward the mercenary life where skill matters more than bloodline. They balance orcish ferocity with human calculation, making them some of the most reliable professional soldiers available. Their loyalty, when earned, is absolute."
    },
    "Sea Serpent": {
      "name": "Sea Serpent",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A colossal serpentine sea creature with gleaming scales, fin-like frills along its back, and the ability to coil around and crush ships at sea. Sea serpents are ancient beings that rarely approach the surface, their existence known primarily through terrified sailors' accounts and the occasional piece of washed-up flotsam. They are intelligent in an alien way, with patience measured in decades. A coastline visited by a sea serpent suffers shipping losses for generations."
    },
    "Phoenix": {
      "name": "Phoenix",
      "vulnerabilities": [
        "cold"
      ],
      "resistances": [],
      "immunities": [
        "fire"
      ],
      "description": "A magnificent bird the size of a great eagle with feathers of living flame and eyes of molten gold. Phoenixes are nearly immortal, dying in a final conflagration only to be reborn from their own ashes. Their feathers carry healing magic and their tears can raise the dead in some legends. They are extraordinarily rare, and nests are almost never found — a phoenix chooses its own place of rebirth."
    },
    "Shadow": {
      "name": "Shadow",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "necrotic",
        "poison",
        "charm",
        "fear"
      ],
      "description": "A humanoid silhouette of pure darkness that drifts silently along walls and ceilings, visible only as a void where light should fall. Shadows drain the strength from those they touch, weakening their victims until exhaustion drops them. Those slain by shadows rise as shadows themselves within days. They are drawn to bright lights as moths to flame, but destroyed by true radiant energy."
    },
    "Specter": {
      "name": "Specter",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing",
        "cold"
      ],
      "immunities": [
        "necrotic",
        "poison",
        "charm",
        "fear"
      ],
      "description": "A translucent ghostly figure bearing the features of its mortal life but twisted by hatred and loss into a hostile shade. Specters lack the specific purpose of ghosts, driven simply by resentment of the living and an inability to move on. They can pass through walls and drain life with their touch. They often haunt the places where they died violently, attacking anyone who ventures too close."
    },
    "Wight": {
      "name": "Wight",
      "vulnerabilities": [
        "radiant"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing",
        "necrotic"
      ],
      "immunities": [
        "poison",
        "charm",
        "fear"
      ],
      "description": "A corrupted undead form of what was once a warrior or king, retaining combat skill while their flesh has dried and blackened around blazing eyes. Wights drain life with their touch and create lesser zombies from their victims. They often retain their arms and armour from life, making them dangerous with both weapon and undead power. They commonly haunt barrow mounds where they were buried with their treasures."
    },
    "Mummy": {
      "name": "Mummy",
      "vulnerabilities": [
        "fire"
      ],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "poison",
        "disease",
        "charm",
        "fear"
      ],
      "description": "A linen-wrapped preserved corpse animated by ancient curses, its dried flesh somehow still moving with dreadful purpose. Mummies guard the tombs of their preserved masters or pharaohs, driven to attack any who disturb the sacred resting place. Their touch carries a withering rot-curse that slowly dries the life from victims over days. Fire is their primary weakness — the dried linen ignites catastrophically."
    },
    "Will-o'-Wisp": {
      "name": "Will-o'-Wisp",
      "vulnerabilities": [],
      "resistances": [
        "piercing",
        "bludgeoning",
        "slashing"
      ],
      "immunities": [
        "lightning",
        "poison"
      ],
      "description": "A small floating orb of eerie blue-white light that drifts through swamps and dark forests, luring travellers off their paths with false hope of civilisation. Will-o'-wisps are the lingering spirits of those who died lost in wilderness, now driven to lead others to the same fate. They feed on fear and despair, drawing sustenance from the terror of their victims. Their light is cold and unnatural, casting no warmth despite its appearance."
    },
    "Gelatinous Cube": {
      "name": "Gelatinous Cube",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "acid",
        "poison",
        "lightning"
      ],
      "description": "A ten-foot cube of translucent acidic slime that oozes through dungeon corridors, nearly invisible in low light until a victim stumbles into it. Gelatinous cubes engulf creatures entirely, dissolving them slowly while victims remain visible trapped in the translucent mass. They move with unthinking hunger, drawn toward movement and warmth. Dungeon corridors patrolled by a cube are perfectly cleaned of debris — and bodies."
    },
    "Giant Spider": {
      "name": "Giant Spider",
      "vulnerabilities": [
        "fire"
      ],
      "resistances": [],
      "immunities": [],
      "description": "A massive arachnid the size of a large dog with eight legs, multiple eyes, and venomous fangs that can drop a warrior with a single bite. Giant spiders lurk in dense webs woven across forest canopies, cave ceilings, and dungeon corners, dropping down on passing prey. They are not intelligent in any meaningful sense, but their hunting instincts have been honed across eons. A single giant spider can populate an entire tunnel system with lethal webbing."
    },
    "Giant Scorpion": {
      "name": "Giant Scorpion",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A massive armoured arachnid with two grasping pincers and a venom-tipped tail that lashes over its head. Giant scorpions haunt deserts and warm caverns, ambush predators that use their armoured shells to shrug off blows as they crush prey in their claws. They are aggressive and territorial, and their venom can paralyse creatures many times their size. Their chitin is prized for crafting armour and weapons."
    },
    "Giant Snake": {
      "name": "Giant Snake",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A massive serpent easily large enough to swallow a grown human whole, constricting its prey to death in crushing coils. Giant snakes lurk in jungles, swamps, and ancient ruins, their coils blending with roots and rubble until it is too late to flee. They are patient ambush hunters, striking once per week and digesting for days. Some are said to be intelligent — a rare few can even speak in hissing whispers."
    },
    "Giant Eagle": {
      "name": "Giant Eagle",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A massive eagle large enough to carry off a sheep or small child, its wingspan wider than a cottage. Giant eagles are intelligent creatures that form bonds with worthy riders and serve as mounts for the rangers and druids of mountain realms. They are noble, proud, and somewhat aloof — they choose their riders, never the reverse. Their nests are located on peaks reachable only by other flying creatures."
    },
    "Giant Wolf": {
      "name": "Giant Wolf",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A massive wolf nearly the size of a horse, with savage jaws and an intelligence exceeding that of ordinary wolves. Giant wolves are often the alpha members of vast packs, leading smaller kin through territory wars and seasonal hunts. They are intensely loyal to those they accept as pack, and some are ridden by goblin or orc shamans. Their howls can be heard for miles across winter landscapes."
    },
    "Dire Bear": {
      "name": "Dire Bear",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A prehistoric-sized bear nearly fifteen feet tall when rearing, with massive claws, a brown or black shaggy coat, and a bite capable of crushing skulls. Dire bears are not fundamentally more intelligent than ordinary bears, but their sheer size and strength elevates them to apex predator status in any ecosystem. They are solitary and fiercely territorial, driving other predators away with thunderous roars. Druids sometimes form bonds with dire bears as their beast companions."
    },
    "Salamander": {
      "name": "Salamander",
      "vulnerabilities": [
        "cold"
      ],
      "resistances": [],
      "immunities": [
        "fire"
      ],
      "description": "A serpent-like elemental creature with a humanoid torso and a long trailing fire-wreathed tail, emerging from the Plane of Fire to serve fire giants and similar masters. Salamanders are skilled weapon-fighters, wielding fiery spears and preferring melee to magic. Their touch scorches, their blood burns, and their homes in the mortal realm typically involve volcanoes or deep forges. They view cold-adapted races with haughty condescension."
    },
    "Azer": {
      "name": "Azer",
      "vulnerabilities": [
        "cold"
      ],
      "resistances": [],
      "immunities": [
        "fire",
        "poison"
      ],
      "description": "A dwarf-like fire elemental with coppery skin, hair and beard of living flame, and the bearing of a master craftsman. Azers dwell on the Plane of Fire in vast forge-cities, where they craft magical weapons and armour of unmatched quality. They are stoic, prideful, and disdainful of lesser craftsmen. A captured azer is often forced to serve as an infernal smith, labour they perform grudgingly but brilliantly."
    },
    "Djinni": {
      "name": "Djinni",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "lightning",
        "thunder"
      ],
      "description": "A noble genie from the Plane of Air, appearing as a tall regal humanoid with wind-tossed hair, elegant robes, and the ability to grant limited wishes. Djinn are prideful, whimsical, and capable of tremendous acts of generosity or cruelty depending on mood and treatment. They possess strong magical ability and can summon storms, tornadoes, and blinding gusts at will. They despise being enslaved or disrespected, and freed djinn remember kindness for centuries."
    },
    "Efreeti": {
      "name": "Efreeti",
      "vulnerabilities": [
        "cold"
      ],
      "resistances": [],
      "immunities": [
        "fire"
      ],
      "description": "A fire genie from the Plane of Fire, appearing as a massive dark-skinned humanoid with flames wreathing their head and eyes like coals. Efreet are haughty, cunning, and untrustworthy by any reasonable measure — wishes granted by them twist in cruel unexpected ways. They serve as warriors and ministers in the Sultan of Efreet's City of Brass, governing entire provinces of elemental fire. Most mortal encounters end in slavery or immolation for the foolish."
    },
    "Dao": {
      "name": "Dao",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "poison"
      ],
      "description": "An earth genie from the Plane of Earth, appearing as a massive humanoid of dark stone, gemstone eyes, and hands callused from centuries of labour. Dao are greedy, envious, and obsessed with wealth and gemstones, trading viciously and enslaving weaker creatures to work their underground mines. They are strong, patient, and cruel in carefully calculated ways. A dao's palace is always carved into living rock and lined with treasures."
    },
    "Marid": {
      "name": "Marid",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "cold"
      ],
      "description": "A water genie from the Plane of Water, appearing as a tall humanoid with blue-green skin, flowing watery hair, and the bearing of a self-important aristocrat. Marids are vain, boastful, and dramatic, claiming to be the greatest of genies and relating impossible tales of their own accomplishments. They prefer conversation and boasting to combat, though they are formidable warriors when finally roused. Their palaces lie beneath vast inland seas."
    },
    "Nothic": {
      "name": "Nothic",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A disturbing hunched aberration with a single massive eye, pale naked flesh, and the twisted remains of wizard's robes clinging to its form. Nothics are wizards who transgressed against magical law or sought forbidden knowledge, cursed into their current form. They see with uncanny insight into the minds of those they meet, knowing secrets others wish hidden. Their gaze can cause rotting decay in living flesh."
    },
    "Otyugh": {
      "name": "Otyugh",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [
        "disease"
      ],
      "description": "A pit-dwelling aberration with three legs, two tentacles ending in spikes, and a mouth ringed with writhing eyestalks. Otyughs feast on refuse, dung, and corpses, making them unwelcome but useful scavengers in some dungeons. They are intelligent enough to communicate telepathically and sometimes bargain for food deliveries with nearby humanoid communities. Their bites carry a host of devastating diseases."
    },
    "Xvart": {
      "name": "Xvart",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A small blue-skinned humanoid with wide yellow eyes, pointed ears, and a manic expression of nervous cunning. Xvarts serve the demon lord of bats, living in caves where they breed giant bats and rats as steeds and pets. They are cowardly but vicious in packs, overwhelming stronger foes through numbers and spite. Their communities are filthy, loud, and surprisingly complex."
    },
    "Kenku": {
      "name": "Kenku",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A flightless bird-humanoid with raven or crow features, inky black feathers, and a curse that prevents them from speaking in their own voice — they can only mimic sounds they have heard. Kenku live in urban slums and pirate ports, forming tight thieves' guilds where communication through quoted phrases has become an art form. They are master forgers, pickpockets, and mimics. Their curse is tied to an ancient betrayal they no longer remember."
    },
    "Aarakocra": {
      "name": "Aarakocra",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A proud bird-humanoid with eagle-like features, colourful plumage, and wings that allow true flight. Aarakocra build their villages on high mountain peaks and maintain a long-standing vigil against incursions from the Elemental Plane of Air. They are friendly to those who approach respectfully, but deeply committed to their guardian duty against elemental evil. Their keen eyes can spot movement miles below on the ground."
    },
    "Tabaxi": {
      "name": "Tabaxi",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A lithe cat-humanoid with a spotted or striped pelt, retractable claws, and a perpetually curious disposition. Tabaxi are wanderers by nature, driven by a culturally ingrained urge to explore, collect stories, and witness strange things personally. Their homelands in distant jungles are largely abandoned for life on the road. They view possessions as temporary and experiences as the true wealth worth gathering."
    },
    "Firbolg": {
      "name": "Firbolg",
      "vulnerabilities": [],
      "resistances": [],
      "immunities": [],
      "description": "A gentle forest giant-kin with pink skin, cowlike ears, and the reclusive nature of a hermit-druid. Firbolgs live deep in ancient forests, tending the wildlife and plants with quiet devotion and natural magic. They are extremely shy of outsiders, capable of turning invisible at will to avoid unwanted attention. Those who earn their trust find firbolgs deeply loyal, though still inclined to slip away when social interaction exhausts them."
    },
    "Goliath": {
      "name": "Goliath",
      "vulnerabilities": [],
      "resistances": [
        "cold"
      ],
      "immunities": [],
      "description": "A massive humanoid nearly eight feet tall with grey stone-patterned skin, carved features, and the bearing of a mountain warrior. Goliaths live in small tribes on the highest mountain peaks, where survival depends on strength, cooperation, and absolute commitment to competition. Every activity is a contest, and status is constantly earned and re-earned through excellence. They view weakness with cold contempt, though their competitive zeal rarely extends into outright cruelty."
    }
  },
