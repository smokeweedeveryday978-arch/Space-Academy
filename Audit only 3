      "requirements": [
        {
          "type": "skill",
          "variable": "Enchantment",
          "amount": 15
        }
      ],
      "bonus": 15,
      "cooldown": 0
    },
    "THIRD LEVEL - Intellect Fortress": {
      "name": "THIRD LEVEL - Intellect Fortress",
