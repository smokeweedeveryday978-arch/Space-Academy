      "requirements": [
        {
          "type": "skill",
          "variable": "Enchantment",
          "amount": 5
        }
      ],
      "bonus": 5,
      "cooldown": 0
    },
    "FIRST LEVEL - Dissonant Whispers": {
      "name": "FIRST LEVEL - Dissonant Whispers",
      "description": "You whisper a discordant melody that only one target can hear, the jarring tones ripping through their mind with psychic agony. The victim is so disturbed by the unsettling sound that they use their next action to flee from you in blind panic.",
      "requirements": [
        {
          "type": "skill",
          "variable": "Enchantment",
          "amount": 5
        }
      ],
      "bonus": 5,
      "cooldown": 0
    },
    "FIRST LEVEL - Hex": {
      "name": "FIRST LEVEL - Hex",
      "description": "You lay a curse on a creature that causes them to suffer additional necrotic damage whenever you strike them, while also afflicting them with reduced effectiveness in one of their abilities of your choosing. The hex can be transferred to a new target if the original dies.",
      "requirements": [
        {
          "type": "skill",
          "variable": "Enchantment",
          "amount": 5
        }
      ],
      "bonus": 5,
      "cooldown": 0
    },
    "SECOND LEVEL - Hold Animal": {
      "name": "SECOND LEVEL - Hold Animal",
