      "complexityType": "complex",
      "detailType": "detailed",
      "areas": {
        "The Stone Hall": {
          "description": "The great carved hall of the dwarf-hold, its pillars hewn from living rock, where the dwarves gather in the glowing dark and the deep memory of their craft is kept.",
          "paths": [
