      "requirements": [
        {
          "type": "skill",
          "variable": "Abjuration",
          "amount": 45
        }
      ],
      "bonus": 45,
      "cooldown": 0
    },
    "NINTH LEVEL - Invulnerability": {
      "name": "NINTH LEVEL - Invulnerability",
