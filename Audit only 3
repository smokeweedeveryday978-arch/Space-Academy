        {
          "type": "skill",
          "variable": "Enchantment",
          "amount": 45
        }
      ],
      "bonus": 45,
      "cooldown": 0
    },
    "FIRST LEVEL - Armor of Agathys": {
      "name": "FIRST LEVEL - Armor of Agathys",
