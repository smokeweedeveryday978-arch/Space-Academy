        {
          "type": "skill",
          "variable": "Enchantment",
          "amount": 15
        }
      ],
      "bonus": 15,
      "cooldown": 0
    },
    "FIFTH LEVEL - Synaptic Static": {
      "name": "FIFTH LEVEL - Synaptic Static",
