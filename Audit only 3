      "requirements": [
        {
          "type": "skill",
          "variable": "Enchantment",
          "amount": 40
        }
      ],
      "bonus": 40,
      "cooldown": 0
    },
    "EIGHTH LEVEL - Demand": {
      "name": "EIGHTH LEVEL - Demand",
