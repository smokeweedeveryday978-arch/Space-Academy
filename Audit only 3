        "The High Seat": {
          "description": "The mountain-seat where a Norse god holds court over the roaring layer, dispensing glory, judgment, and the fierce favor of the Aesir and Vanir.",
          "paths": [
            "The Valkyries' Aerie"
          ]
        },
        "The Fallen Field": {
          "description": "A battle-field where warriors who fell have failed to rise at dawn — staying truly, finally dead — the visible wound in the sacred rebirth-cycle.",
          "paths": [
