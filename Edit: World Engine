      "script": "const acts = check({type:\"action-text\"}) || [];\nconst input = acts.join(\" \").toLowerCase();\nconst wants = /(show|check|what|who|when|status|schedule|timetable|terminal|attendance|missed|qualification|instructor|class|event|calendar|coming up|upcoming)/.test(input);\nif (!wants || !storage.vga_init_done) { skip = true; }\nelse {\n  storage.vga_terminal_used = true;\n  const days=[\"\",\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"], blocks=[\"Morning\",\"Afternoon\",\"Evening\",\"Night\"];\n  const day=storage.vga_day||1, block=storage.vga_block||0, sched=(storage.vga_schedule||{})[String(day)]||[\"\",\"\"];\n  function actual(code){if(!code)return \"Open\";const c=storage.vga_courses[code],s=storage.vga_instructors[c.instructor]||\"Academy\";if(s===\"Academy\")return c.instructor;return c.substitute?c.substitute+\" (substituting; \"+c.instructor+\" is \"+s+\")\":\"CANCELLED (\"+c.instructor+\" is \"+s+\")\";}\n  const m=sched[0]?sched[0]+\" \"+storage.vga_courses[sched[0]].name+\" — \"+actual(sched[0]):\"Open / self-directed\";\n  const a=sched[1]?sched[1]+\" \"+storage.vga_courses[sched[1]].name+\" — \"+actual(sched[1]):\"Open / self-directed\";\n  const summary=Object.keys(storage.vga_courses).map(code=>code+\" \"+(check({type:\"player-resource\",resource:code+\" Attendance\"})||0)).join(\", \");\n  const missed=check({type:\"player-resource\",resource:\"Classes Missed\"})||0, partial=check({type:\"player-resource\",resource:\"Partial Sessions\"})||0;\n  const live=(storage.vga_event_live_labels||[]).join(', ')||'none'; const open=(storage.vga_event_open_labels||[]).filter(x=>!(storage.vga_event_live_labels||[]).includes(x)).join(', ')||'none';\n  const next=storage.vga_event_next_label?storage.vga_event_next_label+' — '+(storage.vga_event_next_days===0?'starts today':storage.vga_event_next_days+' day(s)')+'; '+storage.vga_event_next_area:'none currently scheduled';\n  const completed=(storage.vga_event_completed_labels||[]).join(', ')||'none'; const passed=(storage.vga_event_missed_labels||[]).join(', ')||'none'; const cancelled=(storage.vga_event_cancelled_labels||[]).join(', ')||'none';\n  const inst=\"CADET TERMINAL FACTS — Term \"+storage.vga_term+\", Week \"+storage.vga_week+\", \"+days[day]+\", \"+blocks[block]+\". TODAY: Morning: \"+m+\". Afternoon: \"+a+\n    \". PERSONAL ATTENDANCE: \"+summary+\". Missed: \"+missed+\"; partial: \"+partial+\n    \". CURRENT SESSION: \"+(storage.vga_session_active?storage.vga_session_course+\" with \"+storage.vga_session_instructor+\" (\"+storage.vga_session_topic+\")\":\"none\")+\n    \". MARQUEE EVENTS — Live now: \"+live+\". Preparation/invitations open: \"+open+\". Next: \"+next+\". Completed in play: \"+completed+\". Missed/passed without a completed player-facing scene: \"+passed+\". Cancelled by mobilization: \"+cancelled+\n    \". Answer the player's schedule/calendar question first. Exact ledger/event state is authoritative. Happening/open does not mean attending; missed/cancelled never invents participation or results. Formal qualifications and attendance remain individual in multiplayer.\";\n  effects.push({type:\"story\",instruction:inst});\n}",
