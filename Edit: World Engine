rn;}\nif(/\\bresume clock\\b/i.test(text)){effects.push({type:'write-boolean',key:'daykeeper.clock_paused',operator:'set',value:false});effects.push({type:'story',instruction:'Vanguard Daykeeper fine clock resumed.'});return;}\nif(/\\bdisable daykeeper\\b/i.test(text)){effects.push({type:'write-boolean',key:'daykeeper.enabled',operator:'set',value:false});effects.push({type:'story',instruction:'Vanguard Daykeeper HUD/clock disabled. The Academic Ledger remains active.'});return;}\nif(/\\benable daykeeper\\b/i.test(text)){effects.push({type:'write-boolean',key:'daykeeper.enabled',operator:'set',value:true});effects.push({type:'story',instruction:'Vanguard Daykeeper enabled at stored time '+fmt(current)+'.'});return;}\nconst tm=text.match(/\\bset (?:the )?(?:clock|time) to\\s+(\\d{1,2})(?::([0-5]\\d))?\\s*(am|pm)?\\b/i);\nif(tm){let h=parseInt(tm[1],10),mi=parseInt(tm[2]||'0',10),ap=(tm[3]||'').toLowerCase();if(ap){if(h===12)h=0;if(ap==='pm')h+=12;}if(h>=0&&h<=23){const m=h*60+mi;storage.vga_block=m<750?0:m<1050?1:m<1320?2:3;effects.push({type:'write-number',key:'daykeeper.minutes',operator:'set',value:m});effects.push({type:'story',instruction:'Manual Vanguard clock override applied at '+fmt(m)+' and the academy block display was aligned. No attendance, absence, qualification or instructor state is fabricated by this control.'});}return;}\nif(/\\b(?:time status|clock status|hud status|academy time)\\b/i.test(text)){effects.push({type:'story',instruction:'Current Vanguard time: '+header(current)+'. Fine clock '+(check({type:'read-boolean',key:'daykeeper.clock_paused'})===true?'paused':'running')+'; HUD '+(check({type:'read-boolean',key:'daykeeper.hud_visible'})===false?'hidden':'visible')+'. Academic Ledger state is authoritative for course/instructor/attendance.'});}\n})()"
