      "script": "(()=>{\nif(check({type:'read-boolean',key:'daykeeper.initialized'})!==true)return;\nif(check({type:'read-boolean',key:'daykeeper.enabled'})===false)return;\nconst raw=check({type:'action-text'})||[],arr=Array.isArray(raw)?raw:[raw];\nconst texts=arr.map(x=>String(x||'').trim()).filter(Boolean);\nconst joined=texts.join(' || '),low=joined.toLowerCase();\nconst control=/\\b(?:hide hud|show hud|pause clock|resume clock|disable daykeeper|enable daykeeper|hud help|time status|clock status|hud status|set (?:the )?(?:clock|time) to)\\b/i;\nif(control.test(joined))return;\nconst coarse=/\\b(?:turn in|end (?:the )?day|tomorrow|next day|next week|skip\\s+(?:\\d+|one|two|three|four|five|six|seven|eight|nine|ten|twelve)\\s+(?:days?|weeks?)|spend the (?:morning|afternoon|evening|night)|time skip)\\b/i;\nif(coarse.test(joined))return;\nlet current=check({type:'read-number',key:'daykeeper.minutes'});if(typeof current!=='number')current=450;\nconst visible=check({type:'read-boolean',key:'daykeeper.hud_visible'})!==false;\nconst paused=check({type:'read-boolean',key:'daykeeper.clock_paused'})===true;\nconst term=storage.vga_term||1,week=storage.vga_week||1,day=storage.vga_day||1,block=storage.vga_block||0;\nconst d3=['','Mon','Tue','Wed','Thu','Fri','Sat','Sun'];\nconst fmt=m=>{let v=((m%1440)+1440)%1440,h=Math.floor(v/60),mm=v%60;return String(h).padStart(2,'0')+':'+String(mm).padStart(2,'0');};\nconst period=m=>{let v=((m%1440)+1440)%1440;return v>=300&&v<720?'Morning':v>=720&&v<1020?'Afternoon':v>=1020&&v<1260?'Evening':'Night';};\nconst status=()=>{const sched=(storage.vga_schedule||{})[String(day)]||['',''];const loc=check({type:'party-location'})||'';let a='🌙 Open / self-directed';if(storage.vga_session_active)a='🎓 '+storage.vga_session_course+' '+((((storage.vga_courses||{})[storage.vga_session_course]||{}).name)||'Class');else if(loc&&loc!=='Vanguard Joint Expeditionary Academy'&&loc!=='Resolute Boarding Hulk'&&loc!=='Astrai Liaison Habitat')a='🚀 Operational / away block';else if(block<2&&sched[block])a='🎓 '+sched[block]+' '+storage.vga_courses[sched[block]].name;else if(block===2)a='🌆 Evening / self-directed';else if(block===3)a='🌙 Night / rest';const ws=storage.vga_war_stage||0,al=['🟢 Routine','🟡 Border tension','🟠 Heightened readiness','🔴 Mobilization','🔴 Combat-exposed','🚨 Open war','🚨 Emergency commissioning'];return a+' • '+al[Math.max(0,Math.min(6,ws))];};\nconst header=m=>'⏰ '+fmt(m)+' • T'+term+' W'+week+' '+(d3[day]||'Day')+' • '+period(m)+(check({type:'party-location'})?' • 📍 '+check({type:'party-location'}):'')+' • '+status();\nconst commit=(m,note='')=>{effects.push({type:'write-number',key:'daykeeper.minutes',operator:'set',value:m});if(visible)effects.push({type:'story',instruction:'VANGUARD DAYKEEPER HEADER — Begin the next story response with exactly: \"'+header(m)+'\". '+note+' The trigger clock owns elapsed minutes; do not advance them again in narration.'});};\nif(paused){commit(current,'The Daykeeper fine clock is paused.');return;}\nif(!texts.length){commit(current+10);return;}\nconst zero=/^(?:what time(?: is it)?|status|inventory|journal|map)\\??$/i;if(texts.every(t=>zero.test(t))){commit(current);return;}\nlet deltas=[];\nfor(const txt of texts){const l=txt.toLowerCase();let delta=10;const nums={one:1,two:2,three:3,four:4,five:5,six:6,seven:7,eight:8,nine:9,ten:10,twelve:12};const m=l.match(/\\b(\\d{1,2})\\s*(minutes?|mins?|hours?|hrs?)\\b/);const wm=l.match(/\\b(one|two|three|four|five|six|seven|eight|nine|ten|twelve)\\s+(minutes?|hours?)\\b/);if(m)delta=parseInt(m[1],10)*(m[2].startsWith('h')?60:1);else if(wm)delta=nums[wm[1]]*(wm[2].startsWith('hour')?60:1);else if(/\\b(?:half an hour|half hour)\\b/.test(l))delta=30;else if(/\\b(?:quarter of an hour|quarter hour)\\b/.test(l))delta=15;else if(/\\b(?:an hour|a hour)\\b/.test(l))delta=60;else if(/\\b(?:breakfast|lunch|dinner|meal|date|bath|meeting|hang out|socialize|socialise)\\b/.test(l))delta=60;else if(/\\b(?:work|train|study|research|search