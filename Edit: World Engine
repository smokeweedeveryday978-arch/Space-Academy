  "arcs": {
    "Academy Year": {
      "id": "Academy Year",
      "title": "Academy Year",
      "theme": "Growing from adult cadet into an expeditionary officer while preserving chosen relationships and identity.",
      "surfacePremise": "Pass qualifications, live with the Flight, complete mandatory practicums and decide what kind of officer to become.",
      "expectedConclusion": "The player earns or refuses a commission with a record shaped by academics, field performance, conduct and relationships.",
      "status": "active",
      "minQuestsForConclusion": 3,
      "secrets": []
    },
    "Coming War": {
      "id": "Coming War",
      "title": "The Coming War",
      "theme": "A distant strategic rivalry slowly consumes the academy's assumptions about training and safety.",
      "surfacePremise": "Border incidents, recalls and operational demands increasingly intrude on Vanguard's educational mission.",
      "expectedConclusion": "The player reaches the war as a person shaped by what they learned and whom they chose to stand beside, not as an automatically chosen savior.",
      "status": "dormant",
      "minQuestsForConclusion": 3,
      "secrets": [
        "Senior staff have already drafted accelerated commissioning plans.",
        "Some Concord leaders fear humanity's military acceleration nearly as much as the Varkesh do."
      ]
    },
    "Wings & Rivalries": {
      "id": "Wings & Rivalries",
      "title": "Wings & Rivalries",
      "theme": "flight skill, competition, wingmanship, reputation and the difference between being qualified and being known as good.",
      "surfacePremise": "Simulators, check rides, formation work, inter-Flight competition and rival pilots create a long-running aerospace lane. The player may chase ace status, enjoy flying without caring about fame, mentor others, or focus elsewhere.",
      "expectedConclusion": "The cadet reaches a durable place in Vanguard flight culture through actual results: respected, notorious, quietly reliable, brilliant but inconsistent, or simply qualified. No victory streak or romance with a rival is required.",
      "status": "active",
      "minQuestsForConclusion": 2,
      "secrets": [
        "A high Flight Qualification does not automatically create Academy Reputation; people need a reason to know.",
        "Rival Flights are competitors and peers, not default enemies."
      ]
    },
    "Mud, Vacuum & Steel": {
      "id": "Mud, Vacuum & Steel",
      "title": "Mud, Vacuum & Steel",
      "theme": "boarding, EVA, survival, field craft, casualty care and doing ugly practical work well.",
      "surfacePremise": "Ground exercises, boarding hulks, damage-control work and away missions build the expeditionary half of Vanguard life. The player can become a field specialist, medic, breacher, rescue lead or reluctant all-rounder.",
      "expectedConclusion": "The cadet develops an evidenced expeditionary identity and a record of how they behave when plans fail, without making violence the only proof of competence.",
      "status": "active",
      "minQuestsForConclusion": 2,
      "secrets": [
        "Rescue, restraint, withdrawal and successful evacuation can matter as much as defeating an enemy."
      ]
    },
    "Academy Life": {
      "id": "Academy Life",
      "title": "Academy Life",
      "theme": "classes, roommates, clubs, meals, conduct, ordinary ambition, embarrassment, rest and becoming part of an institution.",
      "surfacePremise": "Vanguard is a place people live, not a mission lobby. The player can care about study, friends, sport, parties, clubs, jobs, fashion, rivalry, sleep, food and ordinary routines while the larger campaign develops.",
      "expectedConclusion": "The academy year leaves a social and personal history beyond qualification scores: people, habits, places, choices, failures and memories that remain relevant when deployment comes.",
      "status": "active",
      "minQuestsForConclusion": 2,
      "secrets": [
        "Quiet life is valid play and does not require a crisis to justify a scene."
      ]
    },
    "Hearts in Uniform": {
      "id": "Hearts in Uniform",
      "title": "Hearts in Uniform",
      "theme": "friendship, attraction, romance, sex, boundaries, breakups, queer life, polyamory and military authority.",
      "surfacePremise": "Adult cadets and staff build relationships under academic pressure and an approaching war. Flirting, dates, hookups, commitment, friendship and refusal may all matter, but rank and instructional authority remain separate from consent.",
      "expectedConclusion": "Relationships become whatever the people actually make them through evidence and consent; no romance, exclusivity, reconciliation or sexual outcome is mandatory.",
      "status": "active",
      "minQuestsForConclusion": 2,
      "secrets": [
        "A relationship score, shared Flight or dramatic rescue never grants consent."
      ]
    },
    "Uplift Generation": {
      "id": "Uplift Generation",
      "title": "Uplift Generation",
      "theme": "rapid technological change, cultural confidence, paternalism, adaptation and what responsible uplift means.",
      "surfacePremise": "Humans remember being uplifted while Astrai are living through it now. Classes, friendships, exchange programmes and policy arguments let the player test what the Concord owes a developing civilization and what outsiders have no right to decide.",
      "expectedConclusion": "The player develops an evidenced position through people and consequences rather than a mandatory pro- or anti-uplift ideology.",
      "status": "active",
      "minQuestsForConclusion": 2,
      "secrets": [
        "Humanity is both a warning and an argument for uplift; the setting does not canonize one simple answer."
      ]
    },
    "The Kharad Question": {
      "id": "The Kharad Question",
      "title": "The Kharad Question",
      "theme": "enemy identity, exile, propaganda, imperial citizenship, reform, loyalty and the difference between a people and a state.",
      "surfacePremise": "Kharad cadets, exiles, defectors, prisoners, civilians and Varkesh personnel complicate the easy equation of species with enemy. The player can engage, distrust, befriend, oppose, investigate or avoid the issue according to evidence.",
      "expectedConclusion": "The player reaches the war with specific relationships and beliefs about the Hegemony and Kharad people, not a racialized enemy shortcut.",
      "status": "active",
      "minQuestsForConclusion": 2,
      "secrets": [
        "The Hegemony contains reformists, professionals, opportunists and true believers; exile does not automatically make someone pro-Concord."
      ]
    }
  },
