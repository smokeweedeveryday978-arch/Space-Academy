 / away block';else if(block<2&&sched[block])a='🎓 '+sched[block]+' '+storage.vga_courses[sched[block]].name;else if(block===2)a='🌆 Evening / self-directed';else if(block===3)a='🌙 Night / rest';const ws=storage.vga_war_stage||0,al=['🟢 Routine','🟡 Border tension','🟠 Heightened readiness','🔴 Mobilization','🔴 Combat-exposed','🚨 Open war','🚨 Emergency commissioning'];return a+' • '+al[Math.max(0,Math.min(6,ws))];};\nconst header=m=>'⏰ '+fmt(m)+' • T'+term+' W'+week+' '+(d3[day]||'Day')+' • '+period(m)+(check({type:'party-location'})?' • 📍 '+check({type:'party-location'}):'')+' • '+status();\nconst commit=(m,note='')=>{effects.push({type:'write-number',key:'daykeeper.minutes',operator:'set',value:m});if(visible)effects.push({type:'story',instruction:'VANGUARD DAYKEEPER HEADER — Begin the next story response with exactly: \"'+header(m)+'\". '+note+' The trigger clock owns elapsed minutes; do not advance them again in narration.'});};\nif(paused){commit(current,'The Daykeeper fine clock is paused.');return;}\nif(!texts.length){commit(current+10);return;}\nconst zero=/^(?:what time(?: is it)?|status|inventory|journal|map)\\??$/i;if(texts.every(t=>zero.test(t))){commit(current);return;}\nlet deltas=[];\nfor(const txt of texts){const l=txt.toLowerCase();let delta=10;const nums={one:1,two:2,three:3,four:4,five:5,six:6,seven:7,eight:8,nine:9,ten:10,twelve:12};const m=l.match(/\\b(\\d{1,2})\\s*(minutes?|mins?|hours?|hrs?)\\b/);const wm=l.match(/\\b(one|two|three|four|five|six|seven|eight|nine|ten|twelve)\\s+(minutes?|hours?)\\b/);if(m)delta=parseInt(m[1],10)*(m[2].startsWith('h')?60:1);else if(wm)delta=nums[wm[1]]*(wm[2].startsWith('hour')?60:1);else if(/\\b(?:half an hour|half hour)\\b/.test(l))delta=30;else if(/\\b(?:quarter of an hour|quarter hour)\\b/.test(l))delta=15;else if(/\\b(?:an hour|a hour)\\b/.test(l))delta=60;else if(/\\b(?:breakfast|lunch|dinner|meal|date|bath|meeting|hang out|socialize|socialise)\\b/.test(l))delta=60;else if(/\\b(?:work|train|study|research|search