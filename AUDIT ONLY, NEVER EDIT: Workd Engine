      "known": true,
      "detailType": "detailed"
    },
    "Terran Union Expeditionary Forces": {
      "name": "Terran Union Expeditionary Forces",
      "basicInfo": "Humanity's rapidly expanding joint space and expeditionary military. Its doctrine prizes adaptability, combined-arms competence and the ability to continue missions after communications or command structures fail.",
      "factionType": "major",
      "hiddenInfo": "Some senior Terran planners believe humanity's unusually fast military adaptation is the only deterrent preventing strategic coercion; others fear the build-up is itself helping make war inevitable.",
      "known": true,
      "detailType": "detailed"
    },
    "Concord of Associated Worlds": {
      "name": "Concord of Associated Worlds",
      "basicInfo": "A pluralistic interstellar alliance that uplifted Earth and now integrates human industry, personnel and territory into its wider political and defensive system.",
      "factionType": "major",
      "hiddenInfo": "Concord members disagree sharply over how much technology and military autonomy Earth should receive. Uplift policy is both humanitarian doctrine and strategic competition.",
      "known": true,
      "detailType": "detailed"
    },
    "Varkesh Hegemony": {
      "name": "Varkesh Hegemony",
      "basicInfo": "An old centralized star state that views Concord expansion and uplift programmes as encirclement. Its forces are disciplined, technologically mature and accustomed to long strategic planning.",
      "factionType": "major",
      "hiddenInfo": "The Hegemony does not consider humanity inherently evil; it considers a rapidly armed, culturally volatile new Concord member an unacceptable future threat. Internal factions disagree between containment, negotiated limits and pre-emptive war.",
      "known": false,
      "detailType": "detailed"
    },
    "Orsine Dominion": {
      "name": "Orsine Dominion",
      "basicInfo": "An authoritarian neighboring power known for state-directed biological engineering, client-species politics and hard security institutions. It cooperates with the Varkesh when interests align.",
