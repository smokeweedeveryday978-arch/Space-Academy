    "Trauma Nanoweave Injector": {
      "name": "Trauma Nanoweave Injector",
      "category": "Consumable",
      "description": "A restricted emergency injector releasing clotting agents, anti-shock drugs and a temporary nanofiber scaffold around damaged tissue. It can pull a badly wounded casualty back from the edge long enough for evacuation, but it cannot recreate a destroyed organ or reverse confirmed death.",
