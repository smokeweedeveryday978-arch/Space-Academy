      "script": "(()=>{\nif(!storage.vga_init_done){skip=true;return;}\nconst term=Number(storage.vga_term||1),week=Number(storage.vga_week||1),day=Number(storage.vga_day||1);\nconst abs=((term-1)*70)+((week-1)*7)+day, war=Number(storage.vga_war_stage||0);\nconst E=[\n {k:'zero_g',label:'Zero-G Games Night',lead:8,start:12,end:14,event:'Zero-G Games',area:'Zero-G Athletics Hall',cancel:99},\n {k:'culture',label:'Concord Culture Night',lead:22,start:26,end:28,event:'Concord Culture Night',area:'Cultural Exchange Hall',cancel:99},\n {k:'interflight',label:'Interflight Games Weekend',lead:29,start:33,end:35,event:'Interflight Games',area:'Zero-G Athletics Hall',cancel:99},\n {k:'founders',label:'Founders Mess',lead:43,start:47,end:49,event:'Founders Mess',area:'Cultural Exchange Hall',cancel:99},\n {k:'formal',label:'Vanguard Formal',lead:50,start:54,end:56,event:'Vanguard Formal',area:'The Commons',cancel:4},\n {k:'career',label:'Posting and Career Fair',lead:78,start:82,end:84,event:'Posting and Career Fair',area:'Docking Concourse',cancel:6},\n {k:'exchange',label:'Concord Exchange Showcase',lead:92,start:96,end:98,event:'Exchange Showcase',area:'Cultural Exchange Hall',cancel:5}\n];\nlet open=[],live=[],completed=[],missed=[],cancelled=[],next=null;\nfor(const e of E){const p='vga_event_'+e.k;let done=storage[p+'_completed']===true,miss=storage[p+'_missed']===true,cancel=storage[p+'_cancelled']===true;\n if(!done&&!miss&&!cancel&&check({type:'narrative-event-status',eventId:e.event,operator:'equals',value:'completed'})===true){done=true;storage[p+'_completed']=true;}\n if(!done&&!miss&&!cancel&&war>=e.cancel&&abs<=e.end){cancel=true;storage[p+'_cancelled']=true;storage[p+'_cancel_reason']='mobilization';}\n if(!done&&!miss&&!cancel&&abs>e.end){miss=true;storage[p+'_missed']=true;}\n const op=!done&&!miss&&!cancel&&abs>=e.lead&&abs<=e.end, li=!done&&!miss&&!cancel&&abs>=e.start&&abs<=e.end;\n storage[p+'_open']=op;storage[p+'_live']=li;\n if(op)open.push(e.label);if