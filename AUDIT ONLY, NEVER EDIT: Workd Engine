    },
    "Naelori Gill-Seal & Hydration Pack": {
      "name": "Naelori Gill-Seal & Hydration Pack",
      "category": "Consumable",
      "description": "A Naelori emergency packet combining gill-safe sealant, isotonic hydration mist and electrolyte gel for desiccation, torn respiratory tissue and dry-environment shock. It is tailored to Naelori physiology and is not a universal healing potion for other species.",
      "bonuses": []
    },
    "Verdari Cambium Repair Gel": {
      "name": "Verdari Cambium Repair Gel",
      "category": "Consumable",
      "description": "A living nutrient gel formulated for Verdari plant-fiber tissue, carrying sterile sugars, minerals and growth regulators that support rapid sealing and regrowth. It can dramatically improve a Verdari casualty’s recovery while being nutritionally useless or unsafe for many animal species.",
      "bonuses": []
    },
    "Kharad Clot-Heat Ampoule": {
      "name": "Kharad Clot-Heat Ampoule",
      "category": "Consumable",
      "description": "A Kharad field injector that combines clotting chemistry with controlled local warming to support reptilian circulation after trauma or cold exposure. It is designed around Kharad blood chemistry and metabolic temperature, not human assumptions.",
      "bonuses": []
    },
    "Astrai Sensory Grounding Patch": {
      "name": "Astrai Sensory Grounding Patch",
      "category": "Consumable",
      "description": "A soft neck-and-sternum patch used during Astrai sensory or emotional overload. It dampens peripheral autonomic noise, steadies breathing and helps the wearer regain functional focus without suppressing personality or reading thoughts; it treats overload, not ordinary sadness or disagreement.",
      "bonuses": []
    },
    "Regen-Matrix Cartridge": {
      "name": "Regen-Matrix Cartridge",
